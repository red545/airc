module airc.mojom;

interface AircRendererConfig {
  SetPageScript(string script);
};

interface AircPageHost {
  Post(string kind, string json);
};

interface AircPage {
  CallPage(string kind, string json);
  Execute(string code);
  Evaluate(string code) => (string? json);
  PictureInPictureDocument() => (string? document);
  EnterPictureInPictureForUser(string document) => (bool opened);
  SetPageColor(string color);
};
