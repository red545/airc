+void FetchKey(crypto::SubtlePassKey subtle_passkey,
+              crypto::apple::KeychainV2* keychain_for_testing,
+              KeyProvider::KeyCallback callback);
+
+// Airc: a key that can't be read is never replaced. The person is asked (Try
+// Again / Continue Without Saved Passwords for Now / Quit); continuing gives no
+// key this launch, so nothing is encrypted, decrypted, deleted or re-encrypted.
+void OnKeyTask(crypto::SubtlePassKey subtle_passkey,
+               crypto::apple::KeychainV2* keychain_for_testing,
+               KeyProvider::KeyCallback callback,
+               base::expected<Encryptor::Key, int> key) {
+  if (key.has_value()) {
+    std::move(callback).Run(kKeyTag, std::move(*key));
+    return;
+  }
+  if (!g_airc_safe_storage_unreadable) {
+    std::move(callback).Run(
+        kKeyTag,
+        base::unexpected(KeyProvider::KeyError::kTemporarilyUnavailable));
+    return;
+  }
+  g_airc_safe_storage_unreadable(
+      key.error(),
+      base::BindOnce(
+          [](crypto::SubtlePassKey subtle_passkey,
+             crypto::apple::KeychainV2* keychain_for_testing,
+             KeyProvider::KeyCallback callback, bool try_again) {
+            if (try_again) {
+              FetchKey(subtle_passkey, keychain_for_testing,
+                       std::move(callback));
+              return;
+            }
+            std::move(callback).Run(
+                kKeyTag, base::unexpected(
+                             KeyProvider::KeyError::kTemporarilyUnavailable));
+          },
+          subtle_passkey, keychain_for_testing, std::move(callback)));
+}
+
+void FetchKey(crypto::SubtlePassKey subtle_passkey,
+              crypto::apple::KeychainV2* keychain_for_testing,
+              KeyProvider::KeyCallback callback) {
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::TaskPriority::USER_BLOCKING, base::MayBlock()},
+      base::BindOnce(&GetKeyTask, subtle_passkey, keychain_for_testing),
+      base::BindOnce(&OnKeyTask, subtle_passkey, keychain_for_testing,
+                     std::move(callback)));
+}
+
 }  // namespace
 
