+      // in the GPU process at once, while the new view's CALayerHost only
+      // comes with the new compositor's first frame, a turn later. A mirror of
+      // the old context (the agent pane's live card, which keeps it until the
+      // new one exists) shows nothing in between. For a page whose host opted
+      // in (AircTab.holdsFramesOnHide), keep the hidden compositor suspended
+      // (no further commits; its last frame stays in the context) for
+      // kAircHoldMs, then destroy it.
+      recyclable_compositor_->Suspend();
+      recyclable_compositor_->compositor()->SetRootLayer(nullptr);
+      ui::RecyclableCompositorMac* held = recyclable_compositor_.get();
+      AircHeldCompositors().push_back(std::move(recyclable_compositor_));
+      base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+          FROM_HERE, base::BindOnce(&AircReleaseHeldCompositor, held),
+          base::Milliseconds(kAircHoldMs));
