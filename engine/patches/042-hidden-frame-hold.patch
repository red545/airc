+// Airc: compositors of hidden views kept for kAircHoldMs (TransitionToState).
+constexpr int kAircHoldMs = 250;
+
+std::vector<std::unique_ptr<ui::RecyclableCompositorMac>>&
+AircHeldCompositors() {
+  static base::NoDestructor<
+      std::vector<std::unique_ptr<ui::RecyclableCompositorMac>>>
+      instance;
+  return *instance.get();
+}
+
+void AircReleaseHeldCompositor(ui::RecyclableCompositorMac* compositor) {
+  std::erase_if(AircHeldCompositors(), [compositor](const auto& held) {
+    return held.get() == compositor;
+  });
+}
