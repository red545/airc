+namespace {
+
+class AircGlobalRegistryAccess : public ExtensionCommandsGlobalRegistry {
+ public:
+  static void Reregister(ExtensionCommandsGlobalRegistry* registry,
+                         content::BrowserContext* context) {
+    for (const scoped_refptr<const Extension>& extension :
+         ExtensionRegistry::Get(context)->enabled_extensions()) {
+      (registry->*(&AircGlobalRegistryAccess::RemoveExtensionKeybinding))(
+          extension.get(), std::string());
+      (registry->*(&AircGlobalRegistryAccess::AddExtensionKeybindings))(
+          extension.get(), std::string());
+    }
+  }
+};
+
+}  // namespace
+
+void AircReregisterGlobalCommands(content::BrowserContext* context) {
+  if (ExtensionCommandsGlobalRegistry* registry =
+          ExtensionCommandsGlobalRegistry::Get(context)) {
+    AircGlobalRegistryAccess::Reregister(registry, context);
+  }
+}
+
 }  // namespace extensions
