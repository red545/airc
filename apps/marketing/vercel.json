{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ../../docs/user ../../docs/release-notes-beta.md ../../assets/screenshots ../../CHROMIUM_VERSION",
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/appcast.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60"
        }
      ]
    },
    {
      "source": "/latest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60"
        }
      ]
    },
    {
      "source": "/download",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/nightly-latest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/ingest/static/:path*",
      "destination": "https://eu-assets.i.posthog.com/static/:path*"
    },
    {
      "source": "/ingest/:path*/",
      "destination": "https://eu.i.posthog.com/:path*/"
    },
    {
      "source": "/ingest/:path*",
      "destination": "https://eu.i.posthog.com/:path*"
    },
    {
      "source": "/appcast.xml",
      "destination": "https://hpqylr02za4pig6a.public.blob.vercel-storage.com/feeds/appcast.xml"
    },
    {
      "source": "/latest.json",
      "destination": "https://hpqylr02za4pig6a.public.blob.vercel-storage.com/feeds/latest.json"
    },
    {
      "source": "/nightly-latest.json",
      "destination": "https://hpqylr02za4pig6a.public.blob.vercel-storage.com/feeds/nightly-latest.json"
    },
    {
      "source": "/download",
      "destination": "/api/download"
    }
  ],
  "redirects": [
    {
      "source": "/releases/:path*",
      "destination": "https://hpqylr02za4pig6a.public.blob.vercel-storage.com/releases/:path*",
      "permanent": true
    }
  ]
}
