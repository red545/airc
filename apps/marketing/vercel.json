{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "ignoreCommand": "bash scripts/vercel-ignore.sh",
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/appcast.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60"
        }
      ]
    },
    {
      "source": "/latest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60"
        }
      ]
    },
    {
      "source": "/releases/:path*",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    },
    {
      "source": "/download",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/nightly-latest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/ingest/static/:path*",
      "destination": "https://eu-assets.i.posthog.com/static/:path*"
    },
    {
      "source": "/ingest/:path*/",
      "destination": "https://eu.i.posthog.com/:path*/"
    },
    {
      "source": "/ingest/:path*",
      "destination": "https://eu.i.posthog.com/:path*"
    },
    {
      "source": "/appcast.xml",
      "destination": "https://hpqylr02za4pig6a.public.blob.vercel-storage.com/feeds/appcast.xml"
    },
    {
      "source": "/latest.json",
      "destination": "https://hpqylr02za4pig6a.public.blob.vercel-storage.com/feeds/latest.json"
    },
    {
      "source": "/nightly-latest.json",
      "destination": "https://hpqylr02za4pig6a.public.blob.vercel-storage.com/feeds/nightly-latest.json"
    },
    {
      "source": "/releases/:path*",
      "destination": "https://hpqylr02za4pig6a.public.blob.vercel-storage.com/releases/:path*"
    },
    {
      "source": "/download",
      "destination": "/api/download"
    },
    {
      "source": "/s/:id([A-Za-z0-9]{12})",
      "destination": "/api/s?id=:id"
    },
    {
      "source": "/e/:id([A-Za-z0-9]{12})",
      "destination": "/api/e?id=:id"
    },
    {
      "source": "/e/:id([A-Za-z0-9]{12})/a/:asset([0-9a-f]{64}\\.[a-z]{3,4})",
      "destination": "/api/e?id=:id&asset=:asset"
    },
    {
      "source": "/admin/boosts",
      "destination": "/api/admin"
    },
    {
      "source": "/admin/feedback",
      "destination": "/api/feedback?view=admin"
    },
    {
      "source": "/api/admin/feedback-reply",
      "destination": "/api/feedback?view=admin&reply=1"
    }
  ],
  "crons": [
    {
      "path": "/api/sweep",
      "schedule": "17 3 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/releases/:version/:build/notes.html",
      "destination": "/changelog#v:version",
      "permanent": false
    }
  ]
}
