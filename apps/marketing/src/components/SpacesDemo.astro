---
// The Spaces demo: one Airc window in three Spaces. The window colour blends and the sidebar rows slide, the way the
// app swipes; the page changes once the next Space is nearer. Two fingers on the window, a drag, the list or ← → move it.
// Built from the nightly's captures: scripts/space-plates.mjs splits each into the window and its rows.
import { Image } from "astro:assets";
import home from "../assets/shots/swipe-personal.webp";
import homeRows from "../assets/shots/swipe-personal-rows.webp";
import work from "../assets/shots/swipe-work.webp";
import workRows from "../assets/shots/swipe-work-rows.webp";
import studio from "../assets/shots/swipe-studio.webp";
import studioRows from "../assets/shots/swipe-studio-rows.webp";

const spaces = [
  {
    emoji: "🏡",
    name: "Home",
    body: "Personal profile. A trip budget, the Lisbon tabs, Hacker News.",
    page: "Wikipedia's article on Arc",
    plate: home,
    rows: homeRows,
  },
  {
    emoji: "💼",
    name: "Work",
    body: "Work profile. GitHub, the WebKit and SwiftUI docs.",
    page: "GitHub's trending repositories",
    plate: work,
    rows: workRows,
  },
  {
    emoji: "🎨",
    name: "Studio",
    body: "Studio profile, in the dark. Colour theory and Oklab.",
    page: "Wikipedia's article on colour theory",
    plate: studio,
    rows: studioRows,
  },
];
const plateWidths = [800, 1280, 1600, 2000];
const plateSizes = "(max-width: 900px) 680px, 760px";
---

<div class="sd" data-sd>
  <div class="sd-side">
    <div class="sd-list" role="group" aria-label="Spaces">
      {spaces.map((s, i) => (
        <button type="button" class="sd-item" data-go={i} data-name={s.name} data-page={s.page} aria-pressed={i === 0 ? "true" : "false"}>
          <span class="sd-emoji" aria-hidden="true">{s.emoji}</span>
          <span class="sd-text">
            <b>{s.name}</b>
            <span>{s.body}</span>
          </span>
          <span class="sd-bar" aria-hidden="true"><i></i></span>
        </button>
      ))}
    </div>
    <p class="sd-hint">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8.500 11V5.500a1.500 1.500 0 0 1 3 0V11m0-1V4a1.500 1.500 0 0 1 3 0v6m0 0V6a1.500 1.500 0 0 1 3 0v7c0 4-2.500 7-6.500 7-3 0-4.500-1.500-6-4l-2-3.500a1.500 1.500 0 0 1 2.500-1.500L8.500 13"></path></svg>
      <span class="sd-hint-pointer">Swipe on the window with two fingers, or drag it.</span>
      <span class="sd-hint-touch">Swipe the window.</span>
    </p>
  </div>

  <div class="sd-stage">
    <div
      class="sd-win"
      tabindex="0"
      role="img"
      aria-label={`An Airc window in the ${spaces[0].name} Space, on ${spaces[0].page}. Use the arrow keys to switch Spaces.`}
    >
      {spaces.map((s, i) => (
        <Image class="sd-plate" src={s.plate} widths={plateWidths} sizes={plateSizes} alt="" style={i === 0 ? "opacity:1" : undefined} />
      ))}
      <div class="sd-rows">
        <div class="sd-track">
          {spaces.map((s) => (
            <Image src={s.rows} widths={[228, 456]} sizes="(max-width: 900px) 122px, 140px" alt="" />
          ))}
        </div>
      </div>
      {spaces.map((s, i) => (
        <Image class={`sd-page${i === 0 ? " on" : ""}`} src={s.plate} widths={plateWidths} sizes={plateSizes} alt="" />
      ))}
    </div>
  </div>
</div>

<script>
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const DWELL = 3400; // ms each Space stays before the demo moves on

  for (const root of document.querySelectorAll<HTMLElement>("[data-sd]")) {
    const win = root.querySelector<HTMLElement>(".sd-win")!;
    const rowsBox = root.querySelector<HTMLElement>(".sd-rows")!;
    const track = root.querySelector<HTMLElement>(".sd-track")!;
    const plates = [...root.querySelectorAll<HTMLElement>(".sd-plate")];
    const pages = [...root.querySelectorAll<HTMLElement>(".sd-page")];
    const items = [...root.querySelectorAll<HTMLButtonElement>("[data-go]")];
    const n = plates.length;

    let pos = 0; // in Spaces: 0 is the first, 1.5 is halfway between the second and third
    let vel = 0;
    let target = 0;
    let response = 0.42;
    let raf = 0;
    let last = 0;
    let shown = 0;
    let z = 10;

    // Past either end the rows stretch, like the app's pager.
    const rubber = (p: number) => (p < 0 ? p * 0.3 : p > n - 1 ? n - 1 + (p - (n - 1)) * 0.3 : p);

    const show = (i: number) => {
      const prev = shown;
      shown = i;
      const pg = pages[i];
      pg.style.zIndex = String(++z);
      pg.classList.add("on");
      setTimeout(() => {
        if (shown !== prev) pages[prev].classList.remove("on");
      }, 260);
      items.forEach((b, k) => b.setAttribute("aria-pressed", String(k === i)));
      win.setAttribute(
        "aria-label",
        `An Airc window in the ${items[i].dataset.name} Space, on ${items[i].dataset.page}. Use the arrow keys to switch Spaces.`,
      );
      if (auto) restartBar(i);
    };

    const render = () => {
      const p = Math.min(n - 1, Math.max(0, pos));
      const lo = Math.min(n - 2, Math.floor(p));
      const f = p - lo;
      // The nearer Space's colour on top, fading in: the blend never dips through transparency.
      plates.forEach((el, i) => {
        el.style.opacity = i === lo ? "1" : i === lo + 1 ? f.toFixed(4) : "0";
        el.style.zIndex = i === lo + 1 ? "2" : "1";
      });
      track.style.transform = `translate3d(${((-pos * 100) / n).toFixed(4)}%,0,0)`;
      const near = Math.round(p);
      if (near !== shown) show(near);
    };

    // A critically damped spring, stepped in small slices so it stays smooth on any frame rate.
    const step = (t: number) => {
      let dt = Math.min(0.05, (t - last) / 1000);
      last = t;
      const w = (2 * Math.PI) / response;
      while (dt > 0) {
        const h = Math.min(dt, 0.004);
        vel += (-w * w * (pos - target) - 2 * w * vel) * h;
        pos += vel * h;
        dt -= h;
      }
      if (Math.abs(pos - target) < 0.0004 && Math.abs(vel) < 0.003) {
        pos = target;
        vel = 0;
        render();
        raf = 0;
        return;
      }
      render();
      raf = requestAnimationFrame(step);
    };

    const go = (to: number, resp = 0.42) => {
      target = Math.max(0, Math.min(n - 1, to));
      response = resp;
      if (reduce) {
        pos = target;
        vel = 0;
        render();
        return;
      }
      if (!raf) {
        last = performance.now();
        raf = requestAnimationFrame(step);
      }
    };

    const halt = () => {
      cancelAnimationFrame(raf);
      raf = 0;
    };

    // The demo plays by itself while it's on screen, until someone takes over.
    let auto = !reduce;
    let visible = false;
    let hover = false;
    let dir = 1;
    let timer = 0;

    const restartBar = (i: number) => {
      items.forEach((b) => b.classList.remove("tick"));
      const b = items[i];
      void b.offsetWidth;
      b.classList.add("tick");
    };

    const schedule = () => {
      clearTimeout(timer);
      if (!auto || !visible || hover) {
        items.forEach((b) => b.classList.remove("tick"));
        return;
      }
      restartBar(shown);
      timer = window.setTimeout(() => {
        let next = target + dir;
        if (next > n - 1 || next < 0) {
          dir = -dir;
          next = target + dir;
        }
        go(next);
        schedule();
      }, DWELL);
    };

    const takeOver = () => {
      if (!auto) return;
      auto = false;
      clearTimeout(timer);
      items.forEach((b) => b.classList.remove("tick"));
      root.classList.add("manual");
    };

    new IntersectionObserver(
      ([e]) => {
        visible = e.isIntersecting;
        schedule();
      },
      { threshold: 0.6 },
    ).observe(win);
    win.addEventListener("pointerenter", (e) => {
      if (e.pointerType !== "mouse") return;
      hover = true;
      schedule();
    });
    win.addEventListener("pointerleave", () => {
      hover = false;
      schedule();
    });

    items.forEach((b, i) =>
      b.addEventListener("click", () => {
        takeOver();
        go(i);
      }),
    );

    win.addEventListener("keydown", (e) => {
      if (e.key !== "ArrowRight" && e.key !== "ArrowLeft") return;
      e.preventDefault();
      takeOver();
      go(Math.round(target) + (e.key === "ArrowRight" ? 1 : -1));
    });

    // One Space is about the sidebar's width of travel, as on the trackpad.
    const unit = () => Math.max(rowsBox.offsetWidth * 1.4, win.offsetWidth * 0.32);

    // Drag (mouse, pen, touch). Vertical moves are left to the page, so it still scrolls on a phone.
    type Drag = { id: number; x: number; y: number; from: number; moved: boolean; lx: number; lt: number; v: number };
    let drag: Drag | null = null;

    win.addEventListener("pointerdown", (e) => {
      if (e.button !== 0) return;
      drag = { id: e.pointerId, x: e.clientX, y: e.clientY, from: pos, moved: false, lx: e.clientX, lt: e.timeStamp, v: 0 };
    });

    win.addEventListener("pointermove", (e) => {
      if (!drag || e.pointerId !== drag.id) return;
      const dx = e.clientX - drag.x;
      const dy = e.clientY - drag.y;
      if (!drag.moved) {
        if (Math.abs(dx) < 6 && Math.abs(dy) < 6) return;
        if (Math.abs(dy) > Math.abs(dx)) {
          drag = null;
          return;
        }
        drag.moved = true;
        win.setPointerCapture(e.pointerId);
        win.classList.add("dragging");
        takeOver();
        halt();
        vel = 0;
      }
      const dt = e.timeStamp - drag.lt;
      if (dt > 0) drag.v = 0.7 * drag.v + 0.3 * ((e.clientX - drag.lx) / dt);
      drag.lx = e.clientX;
      drag.lt = e.timeStamp;
      pos = rubber(drag.from - dx / unit());
      render();
    });

    const release = (e: PointerEvent) => {
      if (!drag || e.pointerId !== drag.id) return;
      const d = drag;
      drag = null;
      win.classList.remove("dragging");
      if (!d.moved) return;
      const from = Math.round(d.from);
      vel = (-d.v * 1000) / unit(); // Spaces per second
      const aim = pos + vel * 0.15;
      go(Math.round(Math.max(from - 1, Math.min(from + 1, aim))), 0.3);
    };
    win.addEventListener("pointerup", release);
    win.addEventListener("pointercancel", release);

    // Two fingers on a trackpad: horizontal wheel events, one Space per swipe, momentum swallowed.
    let swiping = false;
    let swipeFrom = 0;
    let lockUntil = 0;
    let idle = 0;
    win.addEventListener(
      "wheel",
      (e) => {
        if (Math.abs(e.deltaX) <= Math.abs(e.deltaY)) return;
        e.preventDefault();
        const now = performance.now();
        if (now < lockUntil) {
          lockUntil = now + 160;
          return;
        }
        if (!swiping) {
          swiping = true;
          swipeFrom = Math.round(pos);
          takeOver();
          halt();
          vel = 0;
        }
        const dx = e.deltaX * (e.deltaMode === 1 ? 16 : 1);
        pos = rubber(Math.max(swipeFrom - 1.2, Math.min(swipeFrom + 1.2, pos + dx / unit())));
        render();
        clearTimeout(idle);
        idle = window.setTimeout(() => {
          swiping = false;
          lockUntil = performance.now() + 160;
          const moved = pos - swipeFrom;
          go(Math.abs(moved) > 0.16 ? swipeFrom + Math.sign(moved) : swipeFrom, 0.3);
        }, 110);
      },
      { passive: false },
    );
  }
</script>

<style>
  .sd {
    display: grid;
    grid-template-columns: minmax(250px, 300px) minmax(0, 1fr);
  }

  .sd-side {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 32px;
    padding: 36px 28px 32px;
    box-shadow: 1px 0 0 var(--line);
  }

  .sd-list {
    display: grid;
    gap: 4px;
  }

  .sd-item {
    position: relative;
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr);
    gap: 2px 10px;
    align-items: start;
    width: 100%;
    padding: 12px 12px 14px 14px;
    border: 0;
    border-radius: 10px;
    background: none;
    font: inherit;
    text-align: left;
    color: inherit;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .sd-item::before {
    content: "";
    position: absolute;
    left: 0;
    top: 12px;
    bottom: 14px;
    width: 2px;
    border-radius: 2px;
    background: rgb(var(--ink) / 0.9);
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .sd-item:hover { background: rgb(var(--ink) / 0.035); }
  .sd-item[aria-pressed="true"]::before { opacity: 1; }

  .sd-emoji {
    font-size: 19px;
    line-height: 1.3;
    filter: saturate(0.9);
    transition: opacity 0.2s ease, filter 0.2s ease;
  }

  .sd-text { display: grid; gap: 3px; }

  .sd-text b {
    font-size: 15.5px;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: rgb(var(--ink) / 0.42);
    transition: color 0.2s ease;
  }

  .sd-text span {
    font-size: 13.5px;
    line-height: 1.45;
    color: rgb(var(--ink) / 0.4);
    transition: color 0.2s ease;
  }

  .sd-item:not([aria-pressed="true"]) .sd-emoji { opacity: 0.55; filter: saturate(0.4); }
  .sd-item[aria-pressed="true"] .sd-text b { color: rgb(var(--ink) / 0.92); }
  .sd-item[aria-pressed="true"] .sd-text span { color: rgb(var(--ink) / 0.58); }

  /* While the demo plays, a hairline fills under the Space on screen. */
  .sd-bar {
    position: absolute;
    left: 52px;
    right: 12px;
    bottom: 4px;
    height: 2px;
    overflow: hidden;
    border-radius: 2px;
    background: rgb(var(--ink) / 0.06);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .sd-bar i {
    display: block;
    width: 100%;
    height: 100%;
    background: rgb(var(--ink) / 0.35);
    transform: scaleX(0);
    transform-origin: left;
  }

  .sd-item.tick .sd-bar { opacity: 1; }
  .sd-item.tick .sd-bar i { animation: sd-fill 3.4s linear forwards; }

  @keyframes sd-fill { to { transform: scaleX(1); } }

  .sd-hint {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    max-width: 230px;
    font-size: 13px;
    line-height: 1.45;
    color: rgb(var(--ink) / 0.5);
  }

  .sd-hint svg {
    flex: none;
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .sd-hint-touch { display: none; }

  @media (hover: none) {
    .sd-hint-pointer { display: none; }
    .sd-hint-touch { display: inline; }
  }

  /* The stage: Attio's grey cell with a dot grid, the window floating on it. */
  .sd-stage {
    display: grid;
    place-items: center;
    padding: clamp(28px, 4vw, 56px);
    background:
      radial-gradient(circle at 1px 1px, rgb(var(--ink) / 0.075) 1px, transparent 1.4px) 0 0 / 16px 16px,
      var(--bg-sunk);
  }

  .sd-win {
    position: relative;
    width: 100%;
    max-width: 780px;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: clamp(6px, 0.9vw, 11px);
    box-shadow:
      0 0 0 0.5px rgb(0 0 0 / 0.22),
      0 1px 2px rgb(0 0 0 / 0.06),
      0 22px 48px -18px rgb(30 25 20 / 0.42);
    cursor: grab;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
    outline-offset: 4px;
  }

  .sd-win.dragging { cursor: grabbing; }

  .sd-win :global(img) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    pointer-events: none;
    -webkit-user-drag: none;
  }

  .sd-win :global(.sd-plate) { opacity: 0; }

  /* The rows sit exactly where the capture had them: the sidebar under the toolbar, above the Space bar. */
  .sd-rows {
    position: absolute;
    z-index: 5;
    left: 0;
    top: 5.25%;
    width: 17.8125%;
    height: 88.5%;
    overflow: hidden;
  }

  .sd-track {
    position: absolute;
    inset: 0;
    display: flex;
    width: 300%;
    will-change: transform;
  }

  .sd-track :global(img) {
    position: static;
    flex: none;
    width: 33.3334%;
    height: 100%;
  }

  /* The page card: the capture clipped to its 6 pt corners. The next page fades in over the last. */
  .sd-win :global(.sd-page) {
    z-index: 6;
    clip-path: inset(1.25% 0.78125% 1.25% 17.8125% round 0.47% / 0.75%);
    opacity: 0;
    transition: opacity 0.16s ease;
  }

  .sd-win :global(.sd-page.on) { opacity: 1; }

  @media (max-width: 900px) {
    .sd { grid-template-columns: 1fr; }

    .sd-side {
      gap: 14px;
      padding: 20px 16px 16px;
      box-shadow: 0 1px 0 var(--line);
    }

    .sd-list { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px; }

    .sd-item {
      grid-template-columns: 1fr;
      justify-items: center;
      gap: 2px;
      padding: 10px 6px 12px;
      text-align: center;
      background: rgb(var(--ink) / 0.035);
    }

    .sd-item[aria-pressed="true"] { background: var(--surface); box-shadow: 0 0 0 0.5px var(--line-strong), 0 1px 3px rgb(0 0 0 / 0.06); }
    .sd-item::before { display: none; }
    .sd-text span { display: none; }
    .sd-bar { left: 14px; right: 14px; bottom: 5px; }
    .sd-hint { max-width: none; }
    /* The window at 680 px, cropped to its top left: the sidebar and its rows read at twice the size they would at
       full width, with the page running off the edge. */
    .sd-stage {
      display: block;
      place-items: normal;
      height: 320px;
      padding: 20px 0 0 16px;
      overflow: hidden;
    }

    .sd-win {
      width: 680px;
      max-width: none;
      border-radius: 11px;
    }
  }
</style>
