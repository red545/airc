---
// How long Arc has left, as a pill at the top of the page. The numbers come from a tiny script; without JavaScript it
// just says the date.
import { ARC_END } from "../lib/site";
---

<a class="countdown" href="#join" data-end={ARC_END.toISOString()}>
  <span class="lead"><i aria-hidden="true"></i><span class="lead-text">Arc shuts down in</span></span>
  <span class="static">December 22</span>
  <span class="live" hidden>
    <span class="unit"><b data-d>0</b><i>d</i></span>
    <span class="unit"><b data-h>00</b><i>h</i></span>
    <span class="unit"><b data-m>00</b><i>m</i></span>
    <span class="unit"><b data-s>00</b><i>s</i></span>
  </span>
  <svg class="chev" viewBox="0 0 16 16" aria-hidden="true"><path d="M6 4l4 4-4 4" /></svg>
</a>

<script>
  const pad = (n: number) => String(n).padStart(2, "0");
  const roots = [...document.querySelectorAll<HTMLElement>(".countdown")];

  const tick = () => {
    for (const root of roots) {
      const left = Math.max(0, new Date(root.dataset.end ?? "").getTime() - Date.now());
      const live = root.querySelector<HTMLElement>(".live")!;
      const still = root.querySelector<HTMLElement>(".static")!;
      const set = (sel: string, v: string) => {
        const el = root.querySelector<HTMLElement>(sel);
        if (el) el.textContent = v;
      };
      if (left === 0) {
        live.hidden = true;
        still.hidden = false;
        still.textContent = "Arc has shut down.";
        continue;
      }
      const sec = Math.floor(left / 1000);
      set("[data-d]", String(Math.floor(sec / 86400)));
      set("[data-h]", pad(Math.floor((sec % 86400) / 3600)));
      set("[data-m]", pad(Math.floor((sec % 3600) / 60)));
      set("[data-s]", pad(sec % 60));
      live.hidden = false;
      still.hidden = true;
    }
    setTimeout(tick, 1000 - (Date.now() % 1000));
  };
  if (roots.length) tick();
</script>

<style>
  /* An eyebrow pill above the headline (Attio's announcement pill). */
  .countdown {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 32px;
    padding: 0 10px 0 12px;
    border-radius: 999px;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--hl), 0 1px 2px rgb(0 0 0 / 0.04);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: -0.005em;
    font-variant-numeric: tabular-nums;
    color: var(--t1);
    transition: box-shadow 0.15s ease;
  }

  .countdown:hover { box-shadow: inset 0 0 0 1px var(--hl-strong), 0 1px 2px rgb(0 0 0 / 0.06); }

  .lead { display: inline-flex; align-items: center; gap: 8px; color: var(--t2); }

  .lead i {
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--red);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--red) 22%, transparent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .lead i { animation: pulse 2s ease-in-out infinite; }
  }

  @keyframes pulse {
    50% { box-shadow: 0 0 0 5px color-mix(in srgb, var(--red) 0%, transparent); }
  }

  .live[hidden],
  .static[hidden] { display: none; }

  .live { display: inline-flex; align-items: baseline; gap: 6px; }
  .unit { display: inline-flex; align-items: baseline; gap: 1px; }
  .unit b { font-weight: 600; color: var(--t1); }
  .unit i { font-style: normal; color: var(--t3); }
  .static { font-weight: 600; }

  .chev { width: 14px; height: 14px; fill: none; stroke: var(--t3); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }

  @media (max-width: 480px) {
    .lead-text { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  }
</style>
