---
// How long Arc has left, as a pill at the top of the page. The numbers come from a tiny script; without JavaScript it
// just says the date.
import { ARC_END } from "../lib/site";
---

<a class="countdown" href="#join" data-end={ARC_END.toISOString()}>
  <span class="lead"><i aria-hidden="true"></i><span class="lead-text">Arc shuts down in</span></span>
  <span class="static">December 22</span>
  <span class="live" hidden>
    <span class="unit"><b data-d>0</b><i>d</i></span>
    <span class="unit"><b data-h>00</b><i>h</i></span>
    <span class="unit"><b data-m>00</b><i>m</i></span>
    <span class="unit"><b data-s>00</b><i>s</i></span>
  </span>
</a>

<script>
  const pad = (n: number) => String(n).padStart(2, "0");
  const roots = [...document.querySelectorAll<HTMLElement>(".countdown")];

  const tick = () => {
    for (const root of roots) {
      const left = Math.max(0, new Date(root.dataset.end ?? "").getTime() - Date.now());
      const live = root.querySelector<HTMLElement>(".live")!;
      const still = root.querySelector<HTMLElement>(".static")!;
      const set = (sel: string, v: string) => {
        const el = root.querySelector<HTMLElement>(sel);
        if (el) el.textContent = v;
      };
      if (left === 0) {
        live.hidden = true;
        still.hidden = false;
        still.textContent = "Arc has shut down.";
        continue;
      }
      const sec = Math.floor(left / 1000);
      set("[data-d]", String(Math.floor(sec / 86400)));
      set("[data-h]", pad(Math.floor((sec % 86400) / 3600)));
      set("[data-m]", pad(Math.floor((sec % 3600) / 60)));
      set("[data-s]", pad(sec % 60));
      live.hidden = false;
      still.hidden = true;
    }
    setTimeout(tick, 1000 - (Date.now() % 1000));
  };
  if (roots.length) tick();
</script>

<style>
  .countdown {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 6px 16px;
    padding: 9px 20px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.62);
    box-shadow: inset 0 0 0 0.5px rgb(var(--ink) / 0.1), 0 4px 16px -6px rgb(40 30 20 / 0.18);
    font-variant-numeric: tabular-nums;
    color: var(--text);
    transition: background-color 0.15s ease, transform 0.12s var(--spring-settle);
  }

  .countdown:hover { background: rgb(255 255 255 / 0.85); }
  .countdown:active { transform: scale(0.98); }

  .lead {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-2);
  }

  .lead i {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--red);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--red) 25%, transparent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .lead i { animation: pulse 2s ease-in-out infinite; }
  }

  @keyframes pulse {
    50% { box-shadow: 0 0 0 6px color-mix(in srgb, var(--red) 0%, transparent); }
  }

  .live[hidden],
  .static[hidden] { display: none; }

  .live { display: inline-flex; align-items: baseline; gap: 12px; }
  .unit { display: inline-flex; align-items: baseline; gap: 2px; }
  .unit b { font-size: 20px; font-weight: 800; letter-spacing: -0.03em; color: rgb(var(--ink) / 0.95); }
  .unit i { font-style: normal; font-size: 13px; font-weight: 600; color: var(--text-3); }
  .static { font-size: 18px; font-weight: 800; letter-spacing: -0.03em; }

  /* Phones: one row. The headline right below says what it counts down to. */
  @media (max-width: 480px) {
    .countdown { flex-wrap: nowrap; gap: 10px; padding: 8px 16px; }
    .lead-text { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
    .live { gap: 10px; }
    .unit b { font-size: 18px; }
  }
</style>
