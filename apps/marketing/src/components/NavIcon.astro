---
// A favicon for each row of the sidebar, drawn like the little site icons in Arc's tabs: a rounded tile with a glyph.
import claude from "../assets/logos/claude.svg";
import icon from "../assets/icon-small.png";
import { Image } from "astro:assets";

interface Props {
  name: string;
}
const { name } = Astro.props;

// [from, to, glyph]. Glyphs are 24 × 24 outlines drawn in white.
const tiles: Record<string, [string, string, string]> = {
  math: ["#f5a524", "#f08a9a", "M12 5v14M16 8.5C16 7.100 14.200 6 12 6S8 7.100 8 8.500s1.800 2.300 4 2.500 4 1.100 4 2.500-1.800 2.500-4 2.500-4-1.100-4-2.500"],
  loop: ["#6d8cf0", "#86cdf5", "M19.500 11a7.500 7.500 0 0 0-13-4M5 4v4h4M4.500 13a7.500 7.500 0 0 0 13 4M19 20v-4h-4"],
  reborn: ["#b9a2f2", "#efa3c4", "M12 3.500l2 5.500 5.500 2-5.500 2-2 5.500-2-5.500-5.500-2 5.500-2z"],
  spaces: ["#f7b184", "#f08a9a", "M12 3.500a8.500 8.500 0 1 0 0 17c1.600 0 2-1 1.500-2s0-2 1.500-2h2a3 3 0 0 0 3-3c0-5-4-10-8-10z"],
  profiles: ["#53ca9f", "#13b5b0", "M12 4.500a3.500 3.500 0 1 0 0 7 3.500 3.500 0 0 0 0-7zM5 20c.8-4 3.800-6 7-6s6.200 2 7 6"],
  command: ["#2f6af0", "#6d8cf0", "M11 4.500a6.500 6.500 0 1 0 0 13 6.500 6.500 0 0 0 0-13zM20 20l-4.400-4.400"],
  import: ["#b9a2f2", "#6d8cf0", "M12 4v10m0 0l-4-4m4 4l4-4M5 18.500h14"],
  links: ["#13b5b0", "#86cdf5", "M10 14a4 4 0 0 0 5.700 0l3-3a4 4 0 0 0-5.700-5.700l-1 1M14 10a4 4 0 0 0-5.700 0l-3 3A4 4 0 0 0 11 18.700l1-1"],
  library: ["#efa3c4", "#f7b184", "M4 6h16v4H4zM6 10v8h12v-8M10 14h4"],
  why: ["#f08a9a", "#e5484d", "M12 19.500s-7-4.400-7-10a4 4 0 0 1 7-2.600 4 4 0 0 1 7 2.600c0 5.600-7 10-7 10z"],
  works: ["#2f9e62", "#53ca9f", "M5.500 12.500l4.500 4.500L18.500 8"],
  expect: ["#53ca9f", "#2f9e62", "M12 4.500a7.500 7.500 0 1 0 0 15 7.500 7.500 0 0 0 0-15zM8.500 12l2.500 2.500 4.500-5"],
  qa: ["#6d8cf0", "#b9a2f2", "M12 4.500a7.500 7.500 0 1 0 0 15 7.500 7.500 0 0 0 0-15zM9.800 9.700a2.300 2.300 0 1 1 3.400 2c-.8.500-1.200 1-1.200 2M12 16.500v.1"],
};
const tile = tiles[name];
const id = `ni-${name}`;
---

{name === "top" ? (
  <Image class="ni" src={icon} alt="" width={18} height={18} densities={[1, 2]} format="png" />
) : name === "team" ? (
  <span class="ni ni-plain"><img src={claude.src} width="18" height="18" alt="" /></span>
) : (
  <svg class="ni" viewBox="0 0 24 24" aria-hidden="true">
    <defs>
      <linearGradient id={id} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color={tile[0]} />
        <stop offset="1" stop-color={tile[1]} />
      </linearGradient>
    </defs>
    <rect width="24" height="24" rx="6.500" fill={`url(#${id})`} />
    <g transform="translate(3.600 3.600) scale(0.700)" fill="none" stroke="#fff" stroke-width="2.200" stroke-linecap="round" stroke-linejoin="round">
      <path d={tile[2]}></path>
    </g>
  </svg>
)}

<style>
  .ni {
    flex: none;
    width: 18px;
    height: 18px;
    border-radius: 5px;
  }

  .ni-plain {
    display: grid;
    place-items: center;
  }

  .ni-plain img { width: 18px; height: 18px; }
</style>
