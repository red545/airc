---
// Every Airc version: the current stable, the ones before it, and nightlies. Built from the release feeds, then
// refreshed in the browser from /appcast.xml, /latest.json and /nightly-latest.json (60 s caches), so it is never
// staler than a minute even between deploys.
import Layout from "../layouts/Layout.astro";
import Download from "../components/Download.astro";
import { getRelease, getVersions, macOS, megabytes } from "../lib/release";

const latest = await getRelease();
const { all, nightly } = await getVersions();
const stable = all.filter((v) => v.channel === "stable");

const when = (iso: string) =>
  iso
    ? new Date(iso).toLocaleString("en-US", { month: "short", day: "numeric", year: "numeric", hour: "2-digit", minute: "2-digit", hour12: false, timeZone: "UTC" }) + " UTC"
    : "";
---

<Layout title="Versions · Airc" description="Every Airc release: the current stable version, the ones before it, and nightly builds.">
  <article class="versions" data-versions>
    <p class="tag" style="--c:#5b7ee8">Versions</p>
    <h1>Every Airc release. <span>Stable for everyday use, nightly for the newest work.</span></h1>

    <section class="block">
      <h2>Stable</h2>
      <div class="current">
        <div class="current-copy">
          <p class="big"><b data-v-version>Airc {latest.version}</b> <span class="chip chip-stable">Stable</span></p>
          <p class="sub">
            Build <code data-v-build>{latest.build}</code> · <span data-v-date>{when(stable[0]?.date ?? "")}</span> · Apple silicon
            · {macOS(latest.minimumMacOS)} or later · <span data-v-size>{megabytes(latest.size)}</span>
          </p>
          <p class="sha" data-v-sha-row hidden>SHA-256 <code data-v-sha></code></p>
        </div>
        <Download bare from="versions" />
      </div>
      <p class="note">
        Stable updates itself: Airc checks this feed and offers <i>Restart to Update</i> when a verified update is ready.
        Spotify, Netflix and other DRM sites don't play yet, and Safe Browsing isn't active; the{" "}
        <a href={latest.notes}>release notes</a> say what else to know.
      </p>
    </section>

    <section class="block" id="nightly">
      <h2>Nightly</h2>
      <div data-nightly>
        {nightly ? (
          <div class="row">
            <div>
              <p class="row-title"><b>Airc {nightly.version}</b> <span class="chip chip-nightly">Nightly</span></p>
              <p class="sub">Build <code>{nightly.build}</code> · {when(nightly.date)} · {megabytes(nightly.size)}</p>
            </div>
            <a class="btn btn-quiet" href={nightly.url}>Download nightly</a>
          </div>
        ) : (
          <p class="empty">No nightly has been published yet. The first one appears here after a night whose build passes every gate.</p>
        )}
      </div>
      <p class="note">
        Nightlies are built from the latest code every night and published only if the build, the checks and the speed
        tests pass. They get new features first and may have rough edges. To follow them, open
        <b>Settings → General</b> in Airc and choose <b>Nightly</b>; switching back to Stable never downgrades your data.
        What tonight's checks proved is on <a href="/#supported">What works</a>.
      </p>
    </section>

    <section class="block">
      <h2>All releases</h2>
      <ul class="list" data-list>
        {all.map((v) => (
          <li class="row">
            <div>
              <p class="row-title"><b>Airc {v.version}</b> <span class={`chip chip-${v.channel}`}>{v.channel === "nightly" ? "Nightly" : "Stable"}</span></p>
              <p class="sub">Build <code>{v.build}</code> · {when(v.date)}{v.minimumMacOS ? ` · ${macOS(v.minimumMacOS)} or later` : ""}</p>
            </div>
            {v.notes && <a class="btn btn-quiet" href={v.notes}>Release notes</a>}
          </li>
        ))}
      </ul>
      <p class="note">Every build stays available at its own address, so a link to a version never changes.</p>
    </section>
  </article>
</Layout>

<script>
  // Refresh from the live feeds (same origin, 60 s caches).
  const root = document.querySelector<HTMLElement>("[data-versions]");
  const fmt = (b: string) =>
    /^\d{12}$/.test(b)
      ? new Date(`${b.slice(0, 4)}-${b.slice(4, 6)}-${b.slice(6, 8)}T${b.slice(8, 10)}:${b.slice(10, 12)}:00Z`).toLocaleString("en-US", { month: "short", day: "numeric", year: "numeric", hour: "2-digit", minute: "2-digit", hour12: false, timeZone: "UTC" }) + " UTC"
      : "";
  const mb = (n: number) => `${Math.round(n / 1_000_000)} MB`;
  const set = (sel: string, text: string) => root?.querySelectorAll<HTMLElement>(sel).forEach((e) => (e.textContent = text));
  const el = (tag: string, cls: string, html: string) => Object.assign(document.createElement(tag), { className: cls, innerHTML: html });
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);

  async function refresh() {
    try {
      const r = await fetch("/latest.json", { cache: "no-store" });
      if (r.ok) {
        const j = await r.json();
        set("[data-v-version]", `Airc ${j.version}`);
        set("[data-v-build]", j.build);
        set("[data-v-date]", fmt(j.build));
        set("[data-v-size]", mb(j.size));
        set("[data-v-sha]", j.sha256);
        root?.querySelector<HTMLElement>("[data-v-sha-row]")?.removeAttribute("hidden");
      }
    } catch {}
    try {
      const r = await fetch("/nightly-latest.json", { cache: "no-store" });
      if (r.ok) {
        const j = await r.json();
        const box = root?.querySelector("[data-nightly]");
        if (box) {
          box.replaceChildren(
            el(
              "div",
              "row",
              `<div><p class="row-title"><b>Airc ${esc(j.version)}</b> <span class="chip chip-nightly">Nightly</span></p>` +
                `<p class="sub">Build <code>${esc(j.build)}</code> · ${fmt(j.build)} · ${mb(j.size)}</p></div>` +
                `<a class="btn btn-quiet" href="${esc(new URL(j.url).pathname)}">Download nightly</a>`,
            ),
          );
        }
      }
    } catch {}
    try {
      const r = await fetch("/appcast.xml", { cache: "no-store" });
      if (!r.ok) return;
      const doc = new DOMParser().parseFromString(await r.text(), "application/xml");
      const get = (item: Element, name: string) => item.getElementsByTagName(name)[0]?.textContent ?? "";
      const items = [...doc.getElementsByTagName("item")]
        .map((item) => ({
          version: get(item, "sparkle:shortVersionString"),
          build: get(item, "sparkle:version"),
          channel: get(item, "sparkle:channel") || "stable",
          notes: get(item, "sparkle:releaseNotesLink").replace("https://aircbrowser.com", ""),
          min: get(item, "sparkle:minimumSystemVersion").replace(/\.0$/, ""),
        }))
        .sort((a, b) => b.build.localeCompare(a.build));
      const list = root?.querySelector("[data-list]");
      if (!list || !items.length) return;
      list.replaceChildren(
        ...items.map((v) =>
          el(
            "li",
            "row",
            `<div><p class="row-title"><b>Airc ${esc(v.version)}</b> <span class="chip chip-${esc(v.channel)}">${v.channel === "nightly" ? "Nightly" : "Stable"}</span></p>` +
              `<p class="sub">Build <code>${esc(v.build)}</code> · ${fmt(v.build)}${v.min ? ` · macOS ${esc(v.min)} or later` : ""}</p></div>` +
              (v.notes ? `<a class="btn btn-quiet" href="${esc(v.notes)}">Release notes</a>` : ""),
          ),
        ),
      );
    } catch {}
  }
  refresh();
</script>

<style>
  .versions {
    --cont: #7a8190;
    max-width: 820px;
    margin: 0 auto;
    padding: clamp(48px, 7vw, 96px) clamp(20px, 4vw, 56px);
  }

  @media (prefers-color-scheme: dark) {
    .versions { --cont: #a0a6b2; }
  }

  .tag {
    --c: var(--t3);
    display: inline-flex;
    align-items: center;
    height: 24px;
    margin-bottom: 18px;
    padding: 0 9px;
    border-radius: 7px;
    font-size: 12.5px;
    font-weight: 600;
    color: color-mix(in srgb, var(--c) 78%, #000);
    background: color-mix(in srgb, var(--c) 11%, var(--bg));
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--c) 22%, transparent);
  }

  h1 {
    font-size: clamp(30px, 3.4vw, 44px);
    line-height: 1.1;
    font-weight: 550;
    letter-spacing: -0.022em;
    color: var(--t1);
    text-wrap: balance;
  }

  h1 span { color: var(--cont); }

  .block { margin-top: 48px; padding-top: 28px; box-shadow: 0 -1px 0 var(--hl); }

  .block > h2 {
    margin-bottom: 18px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--t3);
  }

  .current {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 24px;
    border-radius: 16px;
    background:
      radial-gradient(80% 120% at 0% 0%, color-mix(in srgb, var(--mint) 16%, transparent), transparent 70%),
      radial-gradient(80% 120% at 100% 100%, color-mix(in srgb, var(--lilac) 18%, transparent), transparent 70%),
      var(--panel);
    box-shadow: inset 0 0 0 1px var(--hl);
  }

  .big { font-size: 22px; letter-spacing: -0.015em; color: var(--t1); }
  .big b { font-weight: 650; }
  .sub { margin-top: 6px; font-size: 14px; font-weight: 500; color: var(--t2); font-variant-numeric: tabular-nums; }
  .sha { margin-top: 6px; font-size: 12px; color: var(--t3); word-break: break-all; }
  code { font-family: var(--mono); font-size: 0.92em; }

  .chip {
    display: inline-flex;
    align-items: center;
    height: 22px;
    margin-left: 6px;
    padding: 0 8px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 600;
    vertical-align: 2px;
  }

  .chip-stable { color: #1d7a49; background: rgb(47 158 98 / 0.12); }
  .chip-nightly { color: #6a3fd0; background: rgb(122 76 240 / 0.12); }

  @media (prefers-color-scheme: dark) {
    .chip-stable { color: #6fd9a0; background: rgb(47 158 98 / 0.2); }
    .chip-nightly { color: #b9a2f2; background: rgb(122 76 240 / 0.22); }
  }

  .note { margin-top: 16px; max-width: 640px; font-size: 14.5px; line-height: 1.6; font-weight: 500; color: var(--t2); }
  .note b { color: var(--t1); font-weight: 600; }

  .note a,
  .empty a { color: var(--t1); text-decoration: underline; text-decoration-color: var(--hl-strong); text-underline-offset: 3px; }

  .empty {
    padding: 18px 20px;
    border-radius: 12px;
    font-size: 14.5px;
    font-weight: 500;
    color: var(--t2);
    background: var(--panel);
    box-shadow: inset 0 0 0 1px var(--hl);
  }

  .list { margin: 0; padding: 0; list-style: none; box-shadow: 0 1px 0 var(--hl); }

  .row,
  .list :global(.row),
  [data-nightly] :global(.row) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 0;
  }

  .list :global(.row) { box-shadow: 0 -1px 0 var(--hl); }

  .row-title,
  .list :global(.row-title),
  [data-nightly] :global(.row-title) { font-size: 16px; color: var(--t1); }

  :global(.versions .row-title b) { font-weight: 600; }

  :global(.versions .row .sub) { margin-top: 2px; font-size: 13.5px; font-weight: 500; color: var(--t2); }

  :global(.versions .chip) {
    display: inline-flex;
    align-items: center;
    height: 22px;
    margin-left: 6px;
    padding: 0 8px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 600;
    vertical-align: 2px;
  }

  :global(.versions .chip-stable) { color: #1d7a49; background: rgb(47 158 98 / 0.12); }
  :global(.versions .chip-nightly) { color: #6a3fd0; background: rgb(122 76 240 / 0.12); }

  :global(.versions .btn) { height: 34px; padding: 0 12px; border-radius: 9px; font-size: 13.5px; }
</style>
