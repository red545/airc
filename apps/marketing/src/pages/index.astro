---
import { Image, Picture } from "astro:assets";
import "@fontsource-variable/newsreader/opsz.css";
import CommandDemo from "../components/CommandDemo.astro";
import Countdown from "../components/Countdown.astro";
import SpacesDemo from "../components/SpacesDemo.astro";
import TintPicker from "../components/TintPicker.astro";
import Tweet from "../components/Tweet.astro";
import Download from "../components/Download.astro";
import Layout from "../layouts/Layout.astro";
import featureList from "../data/features.json";
import status from "../data/status.json";
import { spaceOf } from "../lib/nav";
import { agentsShown, followAlongShown, remoteShown } from "../lib/agents";
import { CONTACT_EMAIL } from "../lib/site";
import nikPhoto from "../assets/nik.webp";
import claudeLogo from "../assets/logos/claude.svg";
import codexLogo from "../assets/logos/codex.svg";
import accountsCard from "../assets/shots/app-accounts-card.webp";
// New in 0.1.2: real captures, cropped by scripts/sync-screenshots.mjs.
import boostColours from "../assets/screens/boosts-card.webp";
import boostFont from "../assets/screens/boosts-font-card.webp";
import boostZap from "../assets/screens/boosts-zap-card.webp";
import littleArc from "../assets/screens/little-arc-window.webp";
import streamingCard from "../assets/screens/drm-site-controls-top.webp";
import importCard from "../assets/shots/app-import-card.webp";
// The Airc Agent: stills from aidemo's master take (2880×1800, the real window), extracted with ffmpeg.
import agentPoster from "../assets/agent/poster.png";
import cropButton from "../assets/agent/crop-button.png";
import cropLive from "../assets/agent/crop-live.png";
import cropApproval from "../assets/agent/crop-approval.png";

// What works: the manifest (src/data/features.json) joined with the latest nightly run (src/data/status.json, written by
// scripts/sync-status.mjs). A feature with a passing check shows as passing; one with no check yet says so.
const supported = featureList.map((f) => ({ ...f, ...status.features[f.id as keyof typeof status.features] }));
const checkedAt = new Date(status.checkedAt);
const checkedLabel =
  checkedAt.toLocaleDateString("en-US", { month: "short", day: "numeric", timeZone: "UTC" }) +
  ", " +
  checkedAt.toLocaleTimeString("en-US", { hour: "2-digit", minute: "2-digit", hour12: false, timeZone: "UTC" }) +
  " UTC";
const chromiumMajor = status.chromium.split(".")[0];
// For AI agents: shown once the release that ships it is published (src/lib/agents.ts); previews show it now.
const agentsOn = await agentsShown();
const followOn = await followAlongShown();
const remoteOn = await remoteShown();
// The Airc Agent: a recording of the real app (artifacts aidemo4: 0.1.61's agent in the main view, on Steepwell, the
// made-up shop in tools/agent-demo-shop).
const agentVideo = {
  width: 1600,
  height: 1000,
  seconds: 41.5,
  alt: "A recording of Airc on a made-up coffee shop: ⌘T opens the Command Bar, Ask is picked, and the task “Compare the Pour and Rapid kettles and buy the better one for pour over coffee. Ask me before you pay.” is typed. The task’s page opens as a tab in Today, with a glow and the bar “Codex is using this tab · Take over · Stop”, while the pane beside it lists each step. The agent searches the shop and puts both kettles side by side; the pointer rests on Take over and Stop. It says why the Pour is better for pour-over, adds it to the bag and goes to payment. At Pay, Airc stops and asks in the pane, Allow once is clicked, the order is placed and the agent says what it bought and why.",
};
// Where each part of the recording starts, in seconds (aidemo4's chapters.json, homepage cut).
const agentChapters = [
  { at: 0, label: "Ask from ⌘T" },
  { at: 5.2, label: "Say what you need" },
  { at: 9, label: "It works in your tab" },
  { at: 17.8, label: "Take over any time" },
  { at: 28.7, label: "It asks before it pays" },
  { at: 36, label: "Done" },
];
const agentPoints = [
  {
    key: "button",
    img: cropButton,
    alt: "Airc's Command Bar in Ask mode, with the ✦ and the task being typed: “Compare the Pour and Rapid kettle…”.",
    title: "Ask from anywhere.",
    body: "Press ⌘T and pick Ask, or click ✦ next to Back and Forward. Use your ChatGPT subscription through Codex, or your own Claude Code. An API key works too.",
  },
  {
    key: "live",
    img: cropLive,
    alt: "The agent's tab in Airc's main view: the made-up shop's two kettles side by side, with a soft glow around the page and the bar “Codex is using this tab · Take over · Stop” at its top.",
    title: "Works in your tab.",
    body: "The task's page opens as a tab in your window, with a glow and a bar. Take over any time, or stop it. Switch away and it keeps going.",
  },
  {
    key: "ask",
    img: cropApproval,
    alt: "Airc's question in the pane: “Pay on steepwell.aircbrowser.com? The “Pay €79.00” button”, with Deny and Allow once.",
    title: "Asks before it pays.",
    body: "Paying, sending, posting and deleting wait for your OK. Allow it once, or press Esc to deny.",
  },
];
const sparkle =
  "M8 1.2c.5 3.3 1.5 4.3 4.8 4.8C9.5 6.5 8.5 7.5 8 10.8 7.5 7.5 6.5 6.5 3.2 6 6.5 5.5 7.5 4.5 8 1.2Zm4.6 7.4c.25 1.6.75 2.1 2.3 2.35-1.55.25-2.05.75-2.3 2.35-.25-1.6-.75-2.1-2.35-2.35 1.6-.25 2.1-.75 2.35-2.35Z";
const agentsCommand = `claude mcp add --scope user airc -- \\\n  "$HOME/Library/Application Support/Airc/bin/airc-mcp"`;

const facts = [
  { big: `Chromium ${chromiumMajor}`, small: "the real engine underneath" },
  { big: `${status.checks.pass.toLocaleString("en-US")} checks`, small: "passed in the latest run" },
  { big: "Apache-2.0", small: "all of it open source" },
  { big: "Free", small: "no account, no ads" },
  { big: "macOS 14+", small: "on Apple silicon" },
];

const maintainers = [
  {
    logo: claudeLogo,
    name: "Claude",
    role: "AI agent · Anthropic",
    body: "Writes the browser: the sidebar, Spaces, the command bar and the engine layer. Most commits carry its name.",
  },
  {
    logo: codexLogo,
    name: "Codex",
    role: "AI agent · OpenAI",
    body: "Works the same repo from the same playbook, in parallel. Two agents, one codebase, no meetings.",
  },
  {
    photo: nikPhoto,
    name: "Nik",
    role: "Human",
    body: "Started Airc when Arc got its end date, to keep the browser going.",
  },
];

const faqs = [
  {
    q: "Why not just switch to Dia?",
    a: "Dia is a different browser. I want Arc's: the sidebar, the Spaces, the command bar. Airc is that, and open source, so no company can take it away again.",
  },
  {
    q: "What happens to my Arc profiles?",
    a: "Airc reads them from Arc and keeps them apart. Each one keeps its own logins, as in Arc. Two Gmail accounts, one window.",
  },
  {
    q: "How do you keep up with Chromium security updates?",
    a: "Every six hours Airc checks for a new Chromium release. An agent moves Airc's patches onto it, strictly, and the build, the tests and the speed checks have to pass before it ships.",
  },
  { q: "Is it free?", a: "Yes. No account, no ads, no subscription." },
  { q: "Do Chrome extensions work?", a: "Yes. Airc is built on Chromium, so you install them from the Chrome Web Store." },
  { q: "What do I need?", a: "A Mac with Apple silicon and macOS 14 or later. Intel Macs aren't supported." },
  {
    q: "Do Spotify, Netflix and other streaming sites work?",
    a: "Yes, since 0.1.2, with Safari's engine: Spotify, Netflix, Disney+ and other supported services open in the same tab. Sign in again there, since Chromium's logins don't carry over, and extensions don't run on those pages. Checked logged out; playback with a real subscription isn't tested yet.",
  },
  {
    q: "Is Safe Browsing on?",
    a: "Not yet. Airc doesn't have Chrome's Safe Browsing protection against phishing and harmful downloads, so don't rely on it for that.",
  },
  {
    q: "Does Airc collect data?",
    a: "Anonymous usage data, on by default: which features get used and how fast Airc is, never what you browse. Turn it off, or see exactly what is sent, in Settings → Privacy. The privacy page lists every event.",
  },
  {
    q: "Does Chrome Sync work?",
    a: "No. Signing in to Google websites works, but Chrome's sync is Google's own. Airc has iCloud Sync instead: since 0.1.3, Settings → Sync keeps your Spaces, pinned tabs, folders and Favorites the same on your Macs, end-to-end encrypted, off until you turn it on.",
  },
  {
    q: "I already deleted Arc. Can I still import?",
    a: "If Arc's data is still on your Mac, yes. Airc reads Arc's files directly, so Arc doesn't need to run. A few logins Arc encrypted in a way Airc can't read are skipped, so some sites may ask you to sign in again.",
  },
];
---

<Layout>
  <section id="top" class="field f-rainbow hero" data-space={spaceOf("top")}>
    <div class="hero-copy">
      <Countdown />
      <h1><span class="red">Arc shuts down on December&nbsp;22.</span> Airc keeps it going.</h1>
      <p class="sub">
        Airc is <strong>the <span class="nowrap">open-source</span> Arc</strong>: a free Mac browser on Chromium with the same
        sidebar, Spaces and&nbsp;⌘T. Nobody can shut it&nbsp;down.
      </p>
      <div id="join" class="join"><Download from="hero" /></div>
    </div>

    <a class="pointer" href="#tweet">
      <span class="pointer-label">The official announcement, from Arc's own company.</span>
      <svg class="arrow" viewBox="0 0 60 90" aria-hidden="true">
        <path class="arrow-line" pathLength="1" d="M30 4 C 8 30, 52 52, 30 80" />
        <path class="arrow-head" d="M16 66 L30 82 L44 66" />
      </svg>
    </a>

    <div id="tweet" class="hero-tweet">
      <Tweet />
    </div>
  </section>

  <div class="frame">
    <ul class="facts" aria-label="Airc at a glance">
      {facts.map((f) => (
        <li>
          <b>{f.big}</b>
          <span>{f.small}</span>
        </li>
      ))}
    </ul>

    <!-- ---------------------------------------------------------------- the Airc Agent (docs/user/agents.md) -->
    {agentsOn && (
      <section id="agents" class="row agent" data-space={spaceOf("agents")}>
        <header class="agent-head">
          <p class="tag" style="--c: var(--t-peach)">New · Airc Agent</p>
          <h2 class="title agent-title">Say what you need. <span class="soft">Airc does it, while you&nbsp;watch.</span></h2>
          <p class="agent-pitch"><b>Use your ChatGPT subscription,</b> or your own Claude Code. The agent works in the sites you're signed in to, and asks before it&nbsp;pays.</p>
          <div class="agent-cta">
            <Download from="agent" bare />
            <a class="try" href="#agent-film" data-agent-jump>
              See how it works
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14m-6-6 6 6 6-6"></path></svg>
            </a>
          </div>
          <p class="agent-keys">
            Open it with <span class="agent-btn" role="img" aria-label="the Airc Agent button (✦)"><svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d={sparkle} fill="currentColor" /></svg></span>
            next to Back and Forward, or press <kbd class="key" title="Option"><svg viewBox="0 0 16 16" role="img" aria-label="Option"><path d="M2 4.5h3.6l4.6 7H14M9.6 4.5H14" /></svg></kbd><kbd class="key" title="Command"><svg viewBox="0 0 16 16" role="img" aria-label="Command"><path d="M6 6V4.5A1.5 1.5 0 1 0 4.5 6h7A1.5 1.5 0 1 0 10 4.5v7a1.5 1.5 0 1 0 1.5-1.5h-7A1.5 1.5 0 1 0 6 11.5Z" /></svg></kbd><kbd>A</kbd>
          </p>
        </header>

        <figure id="agent-film" class="agent-stage">
          <div class="agent-player reveal" data-agent-player>
            <Picture class="agent-poster" src={agentPoster} formats={["avif", "webp"]} widths={[800, 1200, 1600, 2240, 2880]} sizes="(max-width: 900px) calc(100vw - 32px), 1010px" alt="" fetchpriority="low" />
            <video class="agent-video" muted loop playsinline preload="none" width={agentVideo.width} height={agentVideo.height} aria-label={agentVideo.alt} data-agent-video>
              <source data-src="/video/agent-demo-2240.mp4" type="video/mp4" media="(min-width: 901px)" />
              <source data-src="/video/agent-demo-2240.webm" type="video/webm" media="(min-width: 901px)" />
              <source data-src="/video/agent-demo.webm" type="video/webm" />
              <source data-src="/video/agent-demo.mp4" type="video/mp4" />
              <track kind="captions" src="/video/agent-demo.en.vtt" srclang="en" label="English" />
            </video>
            <button type="button" class="agent-play" aria-label="Play the recording" data-agent-play>
              <svg class="i-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l11-6.5a1 1 0 0 0 0-1.72l-11-6.5A1 1 0 0 0 8 5.5Z" /></svg>
              <svg class="i-pause" viewBox="0 0 24 24" aria-hidden="true"><rect x="6.5" y="5" width="4" height="14" rx="1.2" /><rect x="13.5" y="5" width="4" height="14" rx="1.2" /></svg>
            </button>
          </div>
          <div class="agent-bar">
          <button type="button" class="agent-toggle" aria-label="Play the recording" data-agent-play>
              <svg class="i-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l11-6.5a1 1 0 0 0 0-1.72l-11-6.5A1 1 0 0 0 8 5.5Z" /></svg>
              <svg class="i-pause" viewBox="0 0 24 24" aria-hidden="true"><rect x="6.5" y="5" width="4" height="14" rx="1.2" /><rect x="13.5" y="5" width="4" height="14" rx="1.2" /></svg>
          </button>
          <ol class="agent-chapters" aria-label="Chapters" data-agent-chapters>
            {agentChapters.map((c, i) => (
              <li>
                <button type="button" data-at={c.at} data-end={agentChapters[i + 1]?.at ?? agentVideo.seconds}>
                  <span class="bar" aria-hidden="true"><i></i></span>
                  <span class="label">{c.label.split("✦").map((t, k) => (k ? <><svg class="spark" viewBox="0 0 16 16" aria-label="✦" role="img"><path d={sparkle} fill="currentColor" /></svg>{t}</> : t))}</span>
                </button>
              </li>
            ))}
          </ol>
          </div>
          <figcaption>Recorded in Airc on Steepwell, a made-up shop, with the agent's steps scripted for a repeatable take. Every click, keystroke and page is&nbsp;real.</figcaption>
        </figure>

        <ul class="cells cells-3 agent-points">
          {agentPoints.map((p) => (
            <li class="cell">
              <div class="copy">
                <h3>{p.title}</h3>
                <p>{p.body.split("✦").map((t, k) => (k ? <><svg class="spark" viewBox="0 0 16 16" aria-label="✦" role="img"><path d={sparkle} fill="currentColor" /></svg>{t}</> : t))}</p>
              </div>
              <div class={`viz agent-crop agent-crop-${p.key}`}>
                <Image src={p.img} widths={[p.img.width / 2, p.img.width]} sizes="(max-width: 900px) 92vw, 340px" alt={p.alt} loading="lazy" decoding="async" />
              </div>
            </li>
          ))}
        </ul>

        <div class="agents-mcp">
          <div>
            <h3>Use Airc from Claude</h3>
            <p class="agents-lead">Airc also has an MCP connector built in, and it's on. Claude Desktop, Claude Code and other AI apps open pages, read them, click and type for you while you keep working.</p>
            <div class="agents-setup">
              <p><b>Set up in one click:</b> Settings → Agents → Add to Claude Desktop. For Claude Code:</p>
              <pre><code>{agentsCommand}</code></pre>
            </div>
          </div>
          <ul class="agents-safe">
            <li><b>Asks once per app.</b> The first time Claude connects, Airc asks you. Remove it any time.</li>
            <li><b>Never sees your passwords.</b> Airc fills saved logins into the page. No tool returns a password, passkey or cookie.</li>
            <li><b>Never touches private windows.</b> Agents only reach the windows they open, never yours.</li>
            {followOn && <li><b>Follow along.</b> An Agents folder in your sidebar shows what each agent is doing. Watch it live, take over the page, or stop it.</li>}
            {remoteOn && <li><b>From your other devices.</b> Claude Code on your other computers can use Airc on your Mac over Tailscale, after you pair them. Off until you turn it on.</li>}
          </ul>
        </div>
      </section>
    )}

    <!-- ---------------------------------------------------------------- the math: one statement -->
    <section id="math" class="row statement" data-space={spaceOf("math")}>
      <p class="tag" style="--c: var(--t-peach)">The math</p>
      <h2 class="title title-lg">
        Atlassian paid $610&nbsp;million for Arc's company. <span class="soft">It still got an end date. A Chromium browser
        is never finished, and they looked at the work and&nbsp;stopped.</span>
      </h2>
    </section>

    <!-- ---------------------------------------------------------------- the loop: three cells -->
    <section id="loop" class="row" data-space={spaceOf("loop")}>
      <header class="head">
        <p class="tag" style="--c: var(--t-sky)">The loop</p>
        <h2 class="title">AI doesn't get bored of maintenance. <span class="soft">That was the whole problem.</span></h2>
      </header>
      <ol class="cells cells-3">
        <li class="cell">
          <div class="copy">
            <p class="num">01</p>
            <h3>Chrome ships.</h3>
            <p>Airc checks for a new Chromium release every six hours, security respins included.</p>
          </div>
          <div class="viz" data-in>
            <div class="card">
              <div class="card-head"><span>Watching Chromium</span><span class="muted">every 6 h</span></div>
              <div class="line"><i class="led led-on"></i><span>Mac Extended Stable</span><em>followed</em></div>
              <div class="line"><i class="led"></i><span>Mac Stable</span><em>noted</em></div>
              <div class="line line-foot"><span>Airc is on</span><code>{status.chromium}</code></div>
            </div>
          </div>
        </li>
        <li class="cell">
          <div class="copy">
            <p class="num">02</p>
            <h3>An agent ports it.</h3>
            <p>Claude or Codex moves Airc's patches onto the new version. Every hook must apply strictly, or the port stops.</p>
          </div>
          <div class="viz" data-in>
            <div class="card term">
              <div class="card-head">
                <span class="term-dots" aria-hidden="true"><i></i><i></i><i></i></span>
                <span class="term-who">
                  <img src={claudeLogo.src} width="16" height="16" alt="Claude" />
                  <img src={codexLogo.src} width="16" height="16" alt="Codex" />
                </span>
              </div>
              <code class="cmd">engine/apply.sh --check</code>
              <code class="ok">every hook applies strictly</code>
              <code class="cmd">autoninja -C out/Release</code>
              <code class="ok">Airc Framework.framework</code>
              <code class="cmd">scripts/build-app.sh</code>
              <code class="ok">Airc.app</code>
            </div>
          </div>
        </li>
        <li class="cell">
          <div class="copy">
            <p class="num">03</p>
            <h3>It ships when it passes.</h3>
            <p>The build, the checks and the speed tests have to pass. Then it reaches you as a normal update.</p>
          </div>
          <div class="viz" data-in>
            <div class="card">
              <div class="card-head"><span>Release gates</span><span class="muted mono">{status.rev}</span></div>
              <div class="line"><i class="tick"></i><span>Mac build</span></div>
              <div class="line"><i class="tick"></i><span>{status.checks.pass.toLocaleString("en-US")} checks</span><em>{status.checks.fail} failed</em></div>
              <div class="line"><i class="tick"></i><span>Speed</span></div>
              <div class="line line-foot"><span>Reaches you as</span><em class="yes">Restart to Update</em></div>
            </div>
          </div>
        </li>
      </ol>
    </section>

    <!-- ---------------------------------------------------------------- spaces: the live window -->
    <section id="spaces" class="row" data-space={spaceOf("spaces")}>
      <header class="head">
        <p class="tag" style="--c: var(--t-mint)">Spaces</p>
        <h2 class="title">
          Swipe between Spaces. <span class="soft"><span class="wide">Each one keeps its own tabs, its own colour and its own&nbsp;logins.</span><span class="narrow">Their own tabs, colours and&nbsp;logins.</span></span>
        </h2>
      </header>
      <SpacesDemo />
    </section>

    <!-- ---------------------------------------------------------------- the command bar -->
    <section id="command" class="row split" data-space={spaceOf("command")}>
      <div class="split-copy">
        <p class="tag" style="--c: var(--t-sky)">Command bar</p>
        <h2 class="title">Same <span class="glyph">⌘</span>T. <span class="soft">One box for tabs, sites, searches and&nbsp;actions.</span></h2>
        <p class="lede">
          A few letters jump to an open tab, open a site or search. A slash runs any command, with its shortcut beside it.
        </p>
        <button type="button" class="try" data-act="command">
          <span class="wide">Try this page's <kbd>⌘K</kbd></span><span class="narrow">Search this page</span>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"></path></svg>
        </button>
      </div>
      <div class="split-viz">
        <CommandDemo />
      </div>
    </section>

    <!-- ---------------------------------------------------------------- colour and profiles -->
    <section id="colour" class="row" data-space={spaceOf("colour")}>
      <div class="cells cells-2">
        <article class="cell">
          <div class="copy">
            <h3>Every Space has its own colour.</h3>
            <p>Twelve presets or your own, light or dark. The whole window re-tints, the way Arc's does. So does this one.</p>
          </div>
          <div class="viz viz-tall">
            <TintPicker />
          </div>
        </article>
        <article class="cell">
          <div class="copy">
            <h3>Two Gmail accounts. One window.</h3>
            <p>Each Space can carry its own profile, with its own logins, cookies, history and passwords. Arc's come over as they are.</p>
          </div>
          <div class="viz viz-tall viz-shot">
            <Image
              class="shot"
              src={accountsCard}
              widths={[480, 956]}
              sizes="(max-width: 900px) 90vw, 440px"
              alt="Airc's onboarding: three profiles from Arc (Personal with the Personal and Studio Spaces, Acme with Work, Launch with Launch), each with its own Google sign-in."
            />
          </div>
        </article>
      </div>
    </section>

    <!-- ---------------------------------------------------------------- import and links -->
    <section id="import" class="row" data-space={spaceOf("import")}>
      <div class="cells cells-2">
        <article class="cell">
          <div class="copy">
            <h3>Bring your Arc with you.</h3>
            <p>Spaces, pinned tabs, folders, Favorites and logins, read straight from Arc's files on your Mac. Nothing is uploaded.</p>
          </div>
          <div class="viz viz-tall viz-shot">
            <Image
              class="shot"
              src={importCard}
              widths={[480, 956]}
              sizes="(max-width: 900px) 90vw, 440px"
              alt="Airc found Arc 1.171 with 4 Spaces, 3 profiles and 13 tabs, and will bring over Spaces, pinned tabs and folders, Favorites, and logins."
            />
          </div>
        </article>
        <article class="cell">
          <div class="copy">
            <h3>Links land in the right Space.</h3>
            <p>Air Traffic Control sends a link from Mail or Slack to the Space it belongs in, already signed in. Peek opens it in a card over your page.</p>
          </div>
          <div class="viz viz-tall">
            <div class="card atc" data-atc>
              <div class="card-head"><span>Air Traffic Control</span><span class="muted">first match wins</span></div>
              <div class="rule on"><span class="when">URL contains <b>figma.com</b></span><i aria-hidden="true">→</i><span class="to">🎨 Studio</span></div>
              <div class="rule"><span class="when">URL contains <b>github.com</b></span><i aria-hidden="true">→</i><span class="to">💼 Work</span></div>
              <div class="rule"><span class="when">Everything else</span><i aria-hidden="true">→</i><span class="to">Little Airc</span></div>
            </div>
          </div>
        </article>
