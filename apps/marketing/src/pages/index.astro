---
// The homepage. Its system follows attio.com: Inter Display, two-tone headings (a dark lead, a grey continuation),
// a hairline grid of cells, a sticky tab list beside the product, compact 10 px controls and one dark closing
// section. Inside that, everything is Airc: real captures of the app, and demos you can touch.
import { Image } from "astro:assets";
import Countdown from "../components/Countdown.astro";
import Tweet from "../components/Tweet.astro";
import Download from "../components/Download.astro";
import TintPicker from "../components/TintPicker.astro";
import GitHubMark from "../components/GitHubMark.astro";
import { GITHUB_URL } from "../lib/site";
import Layout from "../layouts/Layout.astro";
import featureList from "../data/features.json";
import status from "../data/status.json";
import { spaceOf } from "../lib/nav";
import nikPhoto from "../assets/nik.webp";
import icon from "../assets/icon.png";
import claudeLogo from "../assets/logos/claude.svg";
import codexLogo from "../assets/logos/codex.svg";
// The marketing screenshots: the real app on a synthetic demo setup (assets/screenshots/, copied in by
// scripts/sync-screenshots.mjs). Each is the window with its own shadow on a soft desktop, so the page adds no frame.
import shotPersonal from "../assets/screens/media-controls.webp";
import shotTravel from "../assets/screens/split-view-3.webp";
import shotStudio from "../assets/screens/pinned-split.webp";
import shotWork from "../assets/screens/hero-dark.webp";
import shotSpaces from "../assets/screens/spaces.webp";
import shotProfiles from "../assets/screens/profiles.webp";
import shotCommand from "../assets/screens/command-bar-light.webp";
import shotCommandDark from "../assets/screens/command-bar-dark.webp";
import shotImport from "../assets/screens/onboarding-import.webp";
import shotPeek from "../assets/screens/peek.webp";
import shotSplit from "../assets/screens/split-view-2.webp";
import shotPip from "../assets/screens/picture-in-picture.webp";
import shotBoostColors from "../assets/screens/boosts.webp";
import shotBoostFont from "../assets/screens/boosts-font.webp";
import shotBoostZap from "../assets/screens/boosts-zap.webp";
import shotDrmPanel from "../assets/screens/drm-site-controls-panel.webp";
import shotPrivate from "../assets/screens/private-window.webp";
import shotPreview from "../assets/screens/tab-preview-card.webp";
import shotPreviewDark from "../assets/screens/tab-preview-card-dark.webp";
import { getImage } from "astro:assets";

// The Spaces demo: four Spaces of the same window, each in its own colour and profile.
const demoSpaces = [
  { key: "personal", name: "Personal", emoji: "🏡", colour: "#53ca9f", img: shotPersonal, page: "Kyoto on Wikivoyage, with a radio playing" },
  { key: "travel", name: "Travel", emoji: "✈️", colour: "#86cdf5", img: shotTravel, page: "a map, Lisbon and its trams in a split" },
  { key: "studio", name: "Studio", emoji: "🎨", colour: "#f7b184", img: shotStudio, page: "Bauhaus and Helvetica, pinned as one split" },
  { key: "work", name: "Work", emoji: "💼", colour: "#7a4cf0", img: shotWork, page: "linear.app, in the dark Work profile" },
];


// What works: the manifest (src/data/features.json) joined with the nightly runs (src/data/status.json, written by
// scripts/sync-status.mjs). A feature with a passing check gets a checkmark; one with no check yet says so.
const supported = featureList.map((f) => ({ ...f, ...status.features[f.id as keyof typeof status.features] }));
const checkedAt = new Date(status.checkedAt);
const checkedLabel =
  checkedAt.toLocaleDateString("en-US", { month: "short", day: "numeric", timeZone: "UTC" }) +
  ", " +
  checkedAt.toLocaleTimeString("en-US", { hour: "2-digit", minute: "2-digit", hour12: false, timeZone: "UTC" }) +
  " UTC";
// Counts are for what's in the released version; features marked `next` (in nightly builds, not in a stable release
// yet) are listed but not counted.
const released = supported.filter((f) => !("next" in f && f.next));
const passingCount = released.filter((f) => f.status === "passing").length;
const releasedCount = released.length;
const nextCount = supported.length - releasedCount;

const facts = [
  { value: `Chromium ${status.chromium.split(".")[0]}`, label: "Real Chrome underneath" },
  { value: "Apache-2.0", label: "Open source, all of it" },
  { value: `${passingCount} of ${releasedCount}`, label: "Features pass the nightly checks", href: "#supported" },
  { value: "Apple silicon", label: "macOS 14 or later" },
  { value: "Free", label: "No account, no ads", href: "/privacy" },
];

const steps = [
  { title: "Chrome ships", body: "Every new Chromium release, security respins included, is spotted within six hours." },
  { title: "An agent ports it", body: "Airc's patches move onto the new version, strictly. No guessing, no skipped checks." },
  { title: "A human signs off", body: "Build, tests and speed are checked before it ships. Then it reaches you as a normal update." },
];

const maintainers = [
  {
    key: "claude",
    logo: claudeLogo,
    name: "Claude",
    role: "AI agent · Anthropic",
    body: "Writes the browser: the sidebar, Spaces, the command bar and the engine layer. Most commits carry its name.",
  },
  {
    key: "codex",
    logo: codexLogo,
    name: "Codex",
    role: "AI agent · OpenAI",
    body: "Works the same repo from the same playbook, in parallel with Claude. Two agents, one codebase, no meetings.",
  },
  {
    key: "me",
    name: "Nik",
    role: "Human",
    body: "Reads every Chromium update before it ships, sets the bar and says no. Nothing reaches your Mac without a yes.",
  },
];

const expect = [
  { title: "Open source", body: "Apache-2.0, all of it. Read it, fork it, run it. If I ever stop, anyone can carry on." },
  {
    title: "Agents do the Chromium security updates",
    body: "Claude and Codex port every Chromium security update into Airc. A human checks each one before it ships.",
  },
  { title: "Free", body: "No account, no ads, no subscription. Anonymous usage data is on by default, and one switch turns it off." },
];

const faqs = [
  {
    q: "Why not just switch to Dia?",
    a: "Dia is a different browser. I want Arc's: the sidebar, the Spaces, the command bar. Airc is that, and open source, so no company can take it away again.",
  },
  {
    q: "What happens to my Chrome profiles?",
    a: "Airc reads them from Arc and keeps them apart. Each one keeps its own logins, like in Arc. Two Gmail accounts, one window.",
  },
  {
    q: "How do you keep up with Chromium security updates?",
    a: "Every six hours we check for a new Chromium release. An agent moves Airc's patches onto it, strictly, and a person checks the build, the tests and the speed before it ships.",
  },
  { q: "Is it free?", a: "Yes. No account, no ads, no subscription." },
  { q: "Do Chrome extensions work?", a: "Yes. Airc is built on Chromium, so you install them from the Chrome Web Store." },
  { q: "What do I need?", a: "A Mac with Apple silicon and macOS 14 or later. Intel Macs aren't supported." },
  {
    q: "Do Spotify, Netflix and other streaming sites work?",
    a: "Not in 0.1.0. In the next release (nightly builds first), Spotify, Netflix, Disney+, Max, Apple TV, Apple Music, Prime Video and Tidal open in a Safari-engine page inside Airc, with Apple's FairPlay; every other site stays Chromium. They open without \"browser not supported\", but playback with signed-in accounts is still being tested.",
  },
  {
    q: "Is Safe Browsing on?",
    a: "Not yet. Airc doesn't have Chrome's Safe Browsing protection against phishing and harmful downloads, so don't rely on it for that.",
  },
  {
    q: "Does Airc collect data?",
    a: "Anonymous usage data, on by default: which features get used and how fast Airc is, never what you browse. Turn it off, or see exactly what is sent, in Settings → Privacy. The privacy page lists every event.",
  },
  {
    q: "Does Chrome Sync work?",
    a: "No. Signing in to Google websites works, but browser sync is Google's own and isn't available to other Chromium browsers.",
  },
  {
    q: "I already deleted Arc. Can I still import?",
    a: "If Arc's data is still on your Mac, yes. Airc reads Arc's files directly, so Arc doesn't need to run. A few logins Arc encrypted in a way Airc can't read are skipped, so some sites may ask you to sign in again.",
  },
];

// Boosts: one site, three ways to make it yours. Not in 0.1.0 (it landed after that release's source), so the
// section says when it arrives; drop the note once a stable release carries it.
const boostModes = [
  { key: "colors", label: "Colors", body: "A tint, brightness and contrast, or Invert for a quick dark mode.", img: shotBoostColors, alt: "Wikipedia's Typography article boosted to a warm amber, with the Boost editor open on Colors: tint, brightness, contrast and Invert." },
  { key: "font", label: "Font", body: "A macOS font and a size. The layout keeps its proportions.", img: shotBoostFont, alt: "The same Boost on Font: the article set in Charter, a size step up, with the fonts that come with macOS." },
  { key: "zap", label: "Zap", body: "Click anything away. It stays gone on every visit, and one click brings it back.", img: shotBoostZap, alt: "The same Boost on Zap: Wikipedia's Appearance column zapped away, listed with its undo." },
];

const previewDark = await getImage({ src: shotPreviewDark, widths: [600, 805], format: "webp", quality: 92 });
const commandDark = await getImage({ src: shotCommandDark, widths: [800, 1200, 1800, 2400], format: "webp", quality: 90 });

const panes = [
  { id: "spaces", tab: "Colours", sub: "Re-tint any Space" },
  { id: "profiles", tab: "Profiles", sub: "Two Gmails, one window" },
  { id: "command", tab: "Command bar", sub: "One box for everything" },
  { id: "import", tab: "Import from Arc", sub: "Spaces, tabs, logins" },
  { id: "links", tab: "Links", sub: "Peek, Air Traffic Control" },
  { id: "split", tab: "Split View", sub: "Two or three panes" },
  { id: "pip", tab: "Picture in picture", sub: "Films and calls float" },
  { id: "streaming", tab: "Streaming", sub: "Safari's engine, FairPlay" },
  { id: "private", tab: "Private windows", sub: "Nothing kept, ⇧⌘N" },
  { id: "previews", tab: "Tab previews", sub: "Hover a tab to see it" },
];

// The streaming services that open in Safari's engine (docs/user/protected-media.md lists every one).
const streamingServices = ["Spotify", "Netflix", "Disney+", "Max", "Apple TV", "Apple Music", "Prime Video", "Tidal"];
---

<Layout>
  <div class="grid">
    <!-- ================================================================ hero -->
    <section id="top" class="hero" data-space={spaceOf("top")}>
      <div class="hero-glow" aria-hidden="true"></div>
      <div class="hero-copy">
        <Countdown />
        <h1><span class="red">Arc shuts down on December&nbsp;22.</span><br />Airc keeps it going.</h1>
        <p class="sub">
          Airc is <strong>the <span class="nowrap">open-source</span> Arc</strong>: a free Mac browser on Chromium with the same
          sidebar, Spaces and&nbsp;⌘T. No company can switch it&nbsp;off.
        </p>
        <div id="join" class="join"><Download from="hero" /></div>
      </div>

      <a class="pointer" href="#tweet" aria-label="Jump to the announcement">
        <span>The official announcement, from Arc's own company</span>
        <svg viewBox="0 0 60 90" aria-hidden="true">
          <path class="arrow-line" pathLength="1" d="M30 4 C 8 30, 52 52, 30 80" />
          <path class="arrow-head" d="M16 66 L30 82 L44 66" />
        </svg>
      </a>

      <div id="tweet" class="frame hero-frame">
        <div class="frame-bar">
          <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="frame-url">x.com/arcinternet/status/2113301454597640570</span>
        </div>
        <div class="frame-body post" data-post>
          <Tweet />
          <div class="post-more">
            <button type="button" class="try" data-expand aria-expanded="false">Read the whole post</button>
          </div>
          <div class="post-less">
            <button type="button" class="try" data-collapse>Collapse</button>
            <a class="try" href="https://x.com/arcinternet/status/2113301454597640570" rel="noopener">View on X ↗</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ================================================================ facts -->
    <section class="facts" aria-label="Airc in five facts">
      {facts.map((f) =>
        f.href ? (
          <a class="fact" href={f.href}>
            <b>{f.value}</b>
            <span>{f.label} →</span>
          </a>
        ) : (
          <div class="fact">
            <b>{f.value}</b>
            <span>{f.label}</span>
          </div>
        ),
      )}
    </section>

    <!-- ================================================================ Arc, reborn: the Spaces demo -->
    <section id="reborn" class="sec" data-space={spaceOf("reborn")}>
      <div class="sec-head">
        <p class="tag" style="--c:#9b7cf0">Arc, reborn</p>
        <h2 class="tt">Same sidebar. Same Spaces. <span>Swipe between them, as you did in Arc.</span></h2>
      </div>
      <div class="demo" data-spaces data-active="0" style={`--accent-space:${demoSpaces[0].colour}`}>
        <div class="demo-bar">
          <div class="seg" role="tablist" aria-label="Spaces">
            {demoSpaces.map((sp, i) => (
              <button
                type="button"
                role="tab"
                class="seg-btn"
                data-go={i}
                aria-selected={i === 0 ? "true" : "false"}
                style={`--c:${sp.colour}`}
              >
                <span class="seg-emoji" aria-hidden="true">{sp.emoji}</span>{sp.name}
              </button>
            ))}
          </div>
          <p class="demo-hint">Swipe with two fingers, drag, or use ← →</p>
        </div>
        <div class="demo-view" tabindex="0" aria-label="Airc's Spaces: drag or use the arrow keys to switch">
          <div class="demo-track">
            {demoSpaces.map((sp, i) => (
              <div class="demo-slide" aria-hidden={i === 0 ? "false" : "true"}>
                <Image
                  src={sp.img}
                  widths={[800, 1200, 1800, 2400]}
                  sizes="(max-width: 900px) 100vw, 1040px"
                  quality={92}
                  draggable="false"
                  alt={`The ${sp.name} Space in Airc, showing ${sp.page}.`}
                />
              </div>
            ))}
          </div>
        </div>
        <div class="demo-dots" aria-hidden="true">
          {demoSpaces.map((sp, i) => <span class={i === 0 ? "on" : ""} style={`--c:${sp.colour}`}></span>)}
        </div>
      </div>
    </section>

    <!-- ================================================================ the math -->
    <section id="math" class="sec" data-space={spaceOf("math")}>
      <div class="sec-head">
        <p class="tag" style="--c:#e8892b">The math</p>
        <h2 class="tt">
          Atlassian paid $610&nbsp;million for Arc's company. <span>Arc still got an end&nbsp;date.</span>
        </h2>
      </div>
      <div class="cells cells-2">
        <div class="cell">
          <h3 class="ct">Security is the job that never ends. <span>A new Chromium release every few weeks, and each one has to be ported, patched, built and checked. Their own post says it: that work is only growing.</span></h3>
          <p class="kicker">AI doesn't get bored of maintenance. That was the whole problem.</p>
          <p class="source">
            Sources: <a href="https://x.com/arcinternet/status/2113301454597640570" rel="noopener">Arc's announcement</a> ·{" "}
            <a href="https://www.engadget.com/big-tech/atlassian-is-buying-arc-maker-the-browser-company-for-610-million-145236236.html" rel="noopener">Engadget on the $610M deal</a>.
          </p>
        </div>
        <div class="cell orbit-cell" aria-hidden="true">
          <div class="orbit">
            <span class="ring r1"></span>
            <span class="ring r2"></span>
            <span class="core"><Image src={icon} alt="" width={56} height={56} densities={[1, 2]} format="webp" /></span>
            <span class="chip chip-claude"><img src={claudeLogo.src} width="14" height="14" alt="" /><img src={codexLogo.src} width="14" height="14" alt="" />Claude and Codex port the patches</span>
            <span class="chip chip-codex">{status.checks.pass} checks passed last night</span>
            <span class="chip chip-chromium">Chromium {status.chromium}</span>
            <span class="chip chip-nik"><Image src={nikPhoto} alt="" width={14} height={14} densities={[2, 3]} format="webp" />Nik signs off</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ================================================================ the loop -->
    <section id="loop" class="sec" data-space={spaceOf("loop")}>
      <div class="sec-head">
        <p class="tag" style="--c:#5b7ee8">The loop</p>
        <h2 class="tt">How a Chromium browser stays alive. <span>Every update, ported and checked.</span></h2>
      </div>
      <ol class="cells cells-3 steps">
        <li class="cell step">
          <span class="step-n">01</span>
          <h3 class="ct">{steps[0].title}. <span>{steps[0].body}</span></h3>
          <div class="viz" data-in>
            <div class="card">
              <div class="card-head"><span>Watching Chromium</span><span class="muted">every 6 h</span></div>
              <div class="line"><i class="led led-on"></i><span>Mac Extended Stable</span><em>followed</em></div>
              <div class="line"><i class="led"></i><span>Mac Stable</span><em>noted</em></div>
              <div class="line line-foot"><span>Airc is on</span><code>{status.chromium}</code></div>
            </div>
          </div>
        </li>
        <li class="cell step">
          <span class="step-n">02</span>
          <h3 class="ct">{steps[1].title}. <span>{steps[1].body}</span></h3>
          <div class="viz" data-in>
            <div class="card term">
              <div class="card-head">
                <span class="term-dots" aria-hidden="true"><i></i><i></i><i></i></span>
                <span class="term-who">
                  <img src={claudeLogo.src} width="16" height="16" alt="Claude" />
                  <img src={codexLogo.src} width="16" height="16" alt="Codex" />
                </span>
              </div>
              <code class="cmd">engine/apply.sh --check</code>
              <code class="ok">every hook applies strictly</code>
              <code class="cmd">autoninja -C out/Release</code>
              <code class="ok">Airc Framework.framework</code>
              <code class="cmd">scripts/build-app.sh</code>
              <code class="ok">Airc.app</code>
            </div>
          </div>
        </li>
        <li class="cell step">
          <span class="step-n">03</span>
          <h3 class="ct">{steps[2].title}. <span>{steps[2].body}</span></h3>
          <div class="viz" data-in>
            <div class="card">
              <div class="card-head"><span>Release gates</span><span class="muted mono">{status.rev}</span></div>
              <div class="line"><i class="tick"></i><span>Mac build</span></div>
              <div class="line"><i class="tick"></i><span>{status.checks.pass} checks</span><em>{status.checks.fail} failed</em></div>
              <div class="line"><i class="tick"></i><span>Speed</span></div>
              <div class="line line-foot">
                <Image class="face" src={nikPhoto} alt="" width={20} height={20} densities={[1, 2, 3]} format="webp" />
                <span>Nik</span><em class="yes">Approved</em>
              </div>
            </div>
          </div>
        </li>
      </ol>
    </section>

    <!-- ================================================================ feature explorer (sticky tabs) -->
    <section class="explorer" aria-label="Features">
      <nav class="ex-tabs" aria-label="Features">
        {panes.map((p, i) => (
          <a href={`#${p.id}`} data-pane={p.id} class={i === 0 ? "on" : ""}>
            <b>{p.tab}</b>
            <span>{p.sub}</span>
            <i class="prog" aria-hidden="true"></i>
          </a>
        ))}
      </nav>
      <div class="ex-panes">
        <article id="spaces" class="pane" data-space={spaceOf("spaces")}>
          <h3 class="pt">Every Space has its own colour. <span>Twelve presets, light or dark. Pick one: this page is an Airc window too.</span></h3>
          <div class="pane-demo tint-demo">
            <TintPicker />
          </div>
          <button type="button" class="pane-demo shot shot-tall" data-zoom={shotSpaces.src} data-alt="Four Airc Spaces side by side, each in its own colour and profile: Personal in mint, Travel in sky, Studio in peach and Work in grape." aria-label="Enlarge screenshot">
            <Image src={shotSpaces} widths={[800, 1200, 1800, 2400]} sizes="(max-width: 900px) 100vw, 760px" quality={90} alt="Four Airc Spaces side by side, each in its own colour and profile: Personal in mint, Travel in sky, Studio in peach and Work in grape." />
          </button>
        </article>

        <article id="profiles" class="pane" data-space={spaceOf("profiles")}>
          <h3 class="pt">Work and personal, one swipe apart. <span>Separate profiles, each with its own logins, history and passwords. Two Gmail accounts, one window.</span></h3>
          <button type="button" class="pane-demo shot" data-zoom={shotProfiles.src} data-alt="Create Profile in Airc: choosing which Spaces move to the new profile, each shown in its own colour." aria-label="Enlarge screenshot">
            <Image src={shotProfiles} widths={[800, 1200, 1800, 2400]} sizes="(max-width: 900px) 100vw, 760px" quality={90} alt="Create Profile in Airc: choosing which Spaces move to the new profile, each shown in its own colour." />
          </button>
        </article>

        <article id="command" class="pane" data-space={spaceOf("command")}>
          <h3 class="pt">Same ⌘T. <span>Search, open a site, jump to a tab or run an action from one box.</span></h3>
          <div class="pane-demo pane-cmd">
            <button type="button" class="shot shot-flat" data-zoom={shotCommand.src} data-alt="Airc's command bar." aria-label="Enlarge screenshot">
              <picture>
                <source media="(prefers-color-scheme: dark)" srcset={commandDark.srcSet.attribute} sizes="(max-width: 900px) 100vw, 760px" />
                <Image src={shotCommand} widths={[800, 1200, 1800, 2400]} sizes="(max-width: 900px) 100vw, 760px" quality={90} alt="Airc's command bar in the Travel Space: typing lisbon shows history, open and pinned tabs and search suggestions, with the top hit completed inline." />
              </picture>
            </button>
            <button type="button" class="try" data-act="command">
              Try it on this page <kbd>⌘K</kbd>
            </button>
          </div>
        </article>

        <article id="import" class="pane" data-space={spaceOf("import")}>
          <h3 class="pt">Your whole Arc, moved over. <span>Spaces, pinned tabs, folders, Favorites and passwords, read from Arc's files on your Mac. Nothing is uploaded.</span></h3>
          <button type="button" class="pane-demo shot" data-zoom={shotImport.src} data-alt="Airc's onboarding has found Arc on the Mac: its Spaces, pinned tabs, folders, Favorites and logins, ready to import." aria-label="Enlarge screenshot">
            <Image src={shotImport} widths={[800, 1200, 1800, 2400]} sizes="(max-width: 900px) 100vw, 760px" quality={90} alt="Airc's onboarding has found Arc on the Mac: its Spaces, pinned tabs, folders, Favorites and logins, ready to import." />
          </button>
          {status.features.import.status !== "passing" && (
            <a class="note" href="#supported"><i aria-hidden="true"></i>Built and in the app; its nightly check is pending. A few sites may ask you to sign in again.</a>
          )}
        </article>

        <article id="links" class="pane" data-space={spaceOf("links")}>
          <h3 class="pt">Links go where they belong. <span>Air Traffic Control sends each link to the right Space, already signed in. Peek opens it in a card over your page.</span></h3>
          <button type="button" class="pane-demo shot" data-zoom={shotPeek.src} data-alt="Peek in Airc: a link from the Lisbon article opens in a card over the page, showing the map of Belém." aria-label="Enlarge screenshot">
            <Image src={shotPeek} widths={[800, 1200, 1800, 2400]} sizes="(max-width: 900px) 100vw, 760px" quality={90} alt="Peek in Airc: a link from the Lisbon article opens in a card over the page, showing the map of Belém." />
          </button>
        </article>

        <article id="split" class="pane" data-space={spaceOf("links")}>
          <h3 class="pt">Split View. <span>Two or three pages side by side, as one row in the sidebar. Pin a split, or keep it as a Favorite.</span></h3>
          <button type="button" class="pane-demo shot" data-zoom={shotSplit.src} data-alt="Split View in Airc's Studio Space: Apple's design pages beside Wikipedia's article on colour theory." aria-label="Enlarge screenshot">
            <Image src={shotSplit} widths={[800, 1200, 1800, 2400]} sizes="(max-width: 900px) 100vw, 760px" quality={90} alt="Split View in Airc's Studio Space: Apple's design pages beside Wikipedia's article on colour theory." />
          </button>
        </article>

        <article id="pip" class="pane" data-space={spaceOf("links")}>
          <h3 class="pt">Picture in picture. <span>A film keeps playing in a small window over whatever you open next, with Airc's own controls. Calls too.</span></h3>
          <button type="button" class="pane-demo shot" data-zoom={shotPip.src} data-alt="Picture in picture in Airc: a film floats over the Lisbon article, with Back to Tab, skip, play and a scrubber." aria-label="Enlarge screenshot">
            <Image src={shotPip} widths={[800, 1200, 1800, 2400]} sizes="(max-width: 900px) 100vw, 760px" quality={90} alt="Picture in picture in Airc: a film floats over the Lisbon article, with Back to Tab, skip, play and a scrubber." />
          </button>
        </article>

        <article id="streaming" class="pane" data-space={spaceOf("streaming")}>
          <h3 class="pt">Spotify, Netflix and Disney+ open in Safari's engine. <span>The big streaming services get a page with Apple's FairPlay, right inside Airc. Every other site stays Chromium.</span></h3>
          <div class="pane-demo stream-demo">
            <ul class="services" aria-label="Services that open in Safari's engine">
              {streamingServices.map((n) => <li>{n}</li>)}
            </ul>
            <button type="button" class="stream-shot" data-zoom={shotDrmPanel.src} data-alt="Site Controls on Spotify: the Safari's engine switch, with Apple's FairPlay." aria-label="Enlarge screenshot">
              <Image src={shotDrmPanel} widths={[446]} sizes="360px" quality={92} alt="Site Controls on open.spotify.com: Safari's engine is on, with Apple's FairPlay. Spotify's player needs DRM that Chromium can't offer without Google's certification; here you sign in once, and extensions don't run." />
            </button>
          </div>
          <p class="note note-next">
            <i aria-hidden="true"></i>
            <span>
              Coming in the next release, in <a href="/versions#nightly">nightly builds</a> first. So far every service
              opens without "browser not supported" and a test stream plays; playback with your own account is still
              being tested. One switch in Site Controls sends a site back to Chromium.
            </span>
          </p>
        </article>

        <article id="private" class="pane" data-space={spaceOf("private")}>
          <h3 class="pt">Private windows. <span>⇧⌘N opens a dark window on its own off-the-record profile. Its pages stay out of your history, and its cookies and site data go when you close it.</span></h3>
          <button type="button" class="pane-demo shot" data-zoom={shotPrivate.src} data-alt="A private window in Airc." aria-label="Enlarge screenshot">
            <Image src={shotPrivate} widths={[800, 1200, 1800, 2400]} sizes="(max-width: 900px) 100vw, 760px" quality={90} alt="A private window in Airc: a dark window with its own tabs and New Tab, marked Private, on Wikipedia's article on private browsing. Its note says Airc doesn't keep this window's history, and its cookies and site data go when you close it." />
          </button>
          <p class="note note-next">
            <i aria-hidden="true"></i>
            <span>Coming in the next release, in <a href="/versions#nightly">nightly builds</a> first. Files you download stay in your Downloads folder.</span>
          </p>
