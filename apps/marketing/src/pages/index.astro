<script>
  // The Airc Agent recording. The poster (a <picture>, 2×) holds the frame; the video loads only near the viewport,
  // plays muted while at least a quarter of it is on screen, and fades in over the poster once it plays. With reduced
  // motion or Save-Data it waits for the play button. The chapters below it seek and show where it is.
  const player = document.querySelector<HTMLElement>("[data-agent-player]");
  const video = player?.querySelector<HTMLVideoElement>("video[data-agent-video]");
  const playBtns = [...document.querySelectorAll<HTMLButtonElement>("[data-agent-play]")];
  if (player && video && playBtns.length) {
    const conn = (navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } }).connection;
    const still =
      matchMedia("(prefers-reduced-motion: reduce)").matches || !!conn?.saveData || /(^|-)2g$/.test(conn?.effectiveType ?? "");
    const chapters = [...document.querySelectorAll<HTMLButtonElement>("[data-agent-chapters] button")];
    let loaded = false;
    let paused = still; // the person's choice: autoplay never overrides a pause
    let visible = false;

    const load = () => {
      if (loaded) return;
      loaded = true;
      video.querySelectorAll<HTMLSourceElement>("source[data-src]").forEach((s) => (s.src = s.dataset.src!));
      video.preload = "auto";
      video.load();
    };
    const sync = () => {
      const on = !video.paused;
      player.closest("figure")?.classList.toggle("is-playing", on);
      playBtns.forEach((b) => b.setAttribute("aria-label", on ? "Pause the recording" : "Play the recording"));
    };
    const play = () => {
      load();
      video.play().catch(() => {});
    };
    const toggle = () => {
      paused = !video.paused;
      if (paused) video.pause();
      else play();
    };

    video.addEventListener("playing", () => player.classList.add("has-played"));
    video.addEventListener("play", sync);
    video.addEventListener("pause", sync);
    playBtns.forEach((b) => b.addEventListener("click", toggle));
    video.addEventListener("click", toggle);

    // Chapters: a click seeks there (and plays); the bar of the current one fills as it runs.
    chapters.forEach((b) =>
      b.addEventListener("click", () => {
        load();
        const go = () => (video.currentTime = Number(b.dataset.at));
        if (video.readyState >= 1) go();
        else video.addEventListener("loadedmetadata", go, { once: true });
        paused = false;
        play();
      }),
    );
    const list = document.querySelector<HTMLElement>("[data-agent-chapters]");
    let current = -1;
    const tick = () => {
      const t = video.currentTime;
      chapters.forEach((b, i) => {
        const a = Number(b.dataset.at);
        const e = Number(b.dataset.end);
        const f = Math.min(1, Math.max(0, (t - a) / (e - a)));
        b.style.setProperty("--p", f.toFixed(3));
        if (t >= a && t < e && i !== current) {
          current = i;
          chapters.forEach((c, k) => c.toggleAttribute("aria-current", k === i));
          // On a phone the row scrolls sideways: keep the current chapter in it, without moving the page.
          if (list && list.scrollWidth > list.clientWidth)
            list.scrollTo({ left: b.offsetLeft - 16, behavior: still ? "auto" : "smooth" });
        }
      });
    };
    let raf = 0;
    const loop = () => {
      tick();
      raf = requestAnimationFrame(loop);
    };
    video.addEventListener("play", () => (raf = requestAnimationFrame(loop)));
    video.addEventListener("pause", () => cancelAnimationFrame(raf));
    video.addEventListener("seeked", tick);

    // Load a screen ahead; play while a quarter is visible, unless paused by hand or in still mode.
    new IntersectionObserver(([e]) => e.isIntersecting && !still && load(), { rootMargin: "600px 0px" }).observe(player);
    new IntersectionObserver(
      ([e]) => {
        visible = e.isIntersecting;
        if (visible && !paused) play();
        else if (!visible && !video.paused) video.pause();
      },
      { threshold: 0.25 },
    ).observe(player);
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) video.pause();
      else if (visible && !paused) play();
    });
  }

  // "See how it works": to the recording, and start it (a click is the person asking to see it).
  document.querySelector("[data-agent-jump]")?.addEventListener("click", (ev) => {
    const film = document.getElementById("agent-film");
    if (!film) return;
    ev.preventDefault();
    film.scrollIntoView({ behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth", block: "center" });
    history.replaceState(null, "", "#agent-film");
    document.querySelector<HTMLButtonElement>(".agent-toggle")?.focus({ preventScroll: true });
  });
</script>

<script>
  // Small things that settle in once, when they first come into view.
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries)
        if (e.isIntersecting) {
          e.target.classList.add("in");
          io.unobserve(e.target);
        }
    },
    { threshold: 0.4 },
  );
  document.querySelectorAll("[data-in]").forEach((el) => io.observe(el));

  // Boosts: the tabs show each state; until one is picked, they take turns while the cell is in view.
  for (const box of document.querySelectorAll<HTMLElement>("[data-boost]")) {
    const tabs = [...box.querySelectorAll<HTMLButtonElement>("[data-b]")];
    const shots = [...box.querySelectorAll<HTMLElement>(".boost-stack .shot")];
    let at = 0;
    let timer = 0;
    let picked = false;
    const show = (k: number) => {
      at = k;
      tabs.forEach((b, j) => b.setAttribute("aria-pressed", String(j === k)));
      shots.forEach((s, j) => s.classList.toggle("on", j === k));
    };
    tabs.forEach((b, k) =>
      b.addEventListener("click", () => {
        picked = true;
        clearInterval(timer);
        show(k);
      }),
    );
    if (!matchMedia("(prefers-reduced-motion: reduce)").matches)
      new IntersectionObserver(([e]) => {
        clearInterval(timer);
        if (e.isIntersecting && !picked) timer = window.setInterval(() => show((at + 1) % tabs.length), 2600);
      }).observe(box);
  }

  // Air Traffic Control: the rules light up in turn, the way a link finds its match.
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  for (const atc of document.querySelectorAll<HTMLElement>("[data-atc]")) {
    const rules = [...atc.querySelectorAll<HTMLElement>(".rule")];
    let i = 0;
    let t = 0;
    const tick = () => {
      i = (i + 1) % rules.length;
      rules.forEach((r, k) => r.classList.toggle("on", k === i));
    };
    if (!reduce)
      new IntersectionObserver(([e]) => {
        clearInterval(t);
        if (e.isIntersecting) t = window.setInterval(tick, 2200);
      }).observe(atc);
  }
</script>

