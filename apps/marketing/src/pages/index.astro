        <article id="previews" class="pane" data-space={spaceOf("previews")}>
          <h3 class="pt">Tab previews. <span>Rest the pointer on a tab and a card shows the page as you left it, its title and site, with pin, Favorite, split and Peek one click away.</span></h3>
          <div class="pane-demo preview-demo">
            <button type="button" class="preview-shot" data-zoom={shotPreview.src} data-alt="A tab preview in Airc." aria-label="Enlarge screenshot">
              <picture>
                <source media="(prefers-color-scheme: dark)" srcset={previewDark.srcSet.attribute} sizes="(max-width: 900px) 100vw, 640px" />
                <Image src={shotPreview} widths={[600, 805]} sizes="(max-width: 900px) 100vw, 640px" quality={92} alt="Airc's sidebar with the pointer on the Kyoto tab: a card shows the Wikivoyage page as it was left, its title and en.wikivoyage.org, and buttons to pin, add to Favorites, split and Peek." />
              </picture>
            </button>
          </div>
          <p class="note note-next">
            <i aria-hidden="true"></i>
            <span>Coming in the next release, in <a href="/versions#nightly">nightly builds</a> first. Turn it off in Settings → Appearance.</span>
          </p>
        </article>
      </div>
    </section>

    <!-- ================================================================ boosts -->
    <section id="boosts" class="sec boosts" data-space={spaceOf("boosts")}>
      <div class="sec-head">
        <p class="tag" style="--c:#e0559f">Boosts</p>
        <h2 class="tt">Boosts. Make any site yours. <span>Your colours, your font, and Zap for the parts you never want to see.</span></h2>
        <a class="soon" href="/versions#nightly"><i aria-hidden="true"></i>Coming in the next release, in nightly builds first</a>
      </div>
      <div class="boost" data-boost>
        <div class="boost-tabs" role="tablist" aria-label="Boosts">
          {boostModes.map((m, i) => (
            <button type="button" role="tab" class="boost-tab" data-mode={i} aria-selected={i === 0 ? "true" : "false"}>
              <b>{m.label}</b>
              <span>{m.body}</span>
              <i class="boost-prog" aria-hidden="true"></i>
            </button>
          ))}
          <p class="boost-more">
            <b>Code</b> Your own CSS and JavaScript for a site.
          </p>
          <p class="boost-trust">
            Unlike Arc's, Boosts never leave your Mac: no account, no sync, and only code you write ever runs. The style is
            in place before the page appears, so it never flashes its old look.
          </p>
        </div>
        <div class="boost-view">
          {boostModes.map((m, i) => (
            <button type="button" class={`boost-shot ${i === 0 ? "on" : ""}`} data-shot={i} data-zoom={m.img.src} data-alt={m.alt} aria-label={`Enlarge: ${m.alt}`} aria-hidden={i === 0 ? "false" : "true"} tabindex={i === 0 ? 0 : -1}>
              <Image src={m.img} widths={[800, 1200, 1800, 2400]} sizes="(max-width: 980px) 100vw, 700px" quality={90} alt={m.alt} loading="lazy" />
            </button>
          ))}
        </div>
      </div>
    </section>

    <!-- ================================================================ what works -->
    <section id="supported" class="sec" data-space={spaceOf("supported")}>
      <div class="sec-head">
        <p class="tag" style="--c:#2f9e62">What works</p>
        <h2 class="tt">What works today. <span>Checked every night on real Chromium.</span></h2>
      </div>
      <div class="run">
        <span class="run-dot" aria-hidden="true"></span>
        <span>
          <b>{passingCount} of {releasedCount} released features</b> pass the nightly checks ({status.checks.pass} checks passed,{" "}
          {status.checks.skip} skipped, {status.checks.fail} failed), and {nextCount} more are on the way in the next release. <i class="pend-dot" aria-hidden="true"></i> Check pending: built, not covered by a check yet.
        </span>
        <span class="run-meta">Last run {checkedLabel} · build <code>{status.rev}</code> · Chromium {status.chromium}</span>
      </div>
      <ul class="works">
        {supported.map((f) => (
          <li class="work">
            {f.status === "built" ? (
              <span
                class={`state pending ${"next" in f && f.next ? "pending-next" : ""}`}
                title={"next" in f && f.next ? "Coming in the next release; in nightly builds first." : "Built and in the app. No nightly check covers it yet."}
              ><i aria-hidden="true"></i></span>
            ) : (
              <span
                class={`state mark mark-${f.status}`}
                role="img"
                aria-label={f.status === "passing" ? "Passing" : "Failing"}
                title={`${f.pass} checks passed${f.skip ? `, ${f.skip} skipped` : ""}${f.fail ? `, ${f.fail} failed` : ""}.`}
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  {f.status === "passing" ? <path d="M6 12.5l4 4 8-9" /> : <path d="M7 7l10 10M17 7L7 17" />}
                </svg>
              </span>
            )}
            <div>
              <h3>
                {f.title}
                {"next" in f && f.next ? <span class="next-label">Next release</span> : f.status === "built" && <span class="pend-label">Check pending</span>}
              </h3>
              <p>{f.body}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <!-- ================================================================ why -->
    <section id="why" class="sec why" data-space={spaceOf("why")}>
      <figure class="quote">
        <p class="tag" style="--c:#e5484d">Why I'm building this</p>
        <blockquote>
          “I love Arc. I don't want to switch, and I don't want to relearn my browser because a company changed its&nbsp;mind.”
        </blockquote>
        <p class="quote-sub">What I'd miss most is the profiles: work and personal, each with its own logins, in one window. Airc keeps that.</p>
        <figcaption>
          <Image class="why-photo" src={nikPhoto} alt="" width={48} height={48} densities={[1, 2, 3]} format="webp" />
          <span><b>Nik</b>, who builds Airc</span>
        </figcaption>
      </figure>
    </section>

    <!-- ================================================================ what to expect -->
    <section id="expect" class="sec" data-space={spaceOf("expect")}>
      <div class="sec-head">
        <p class="tag" style="--c:#2f9e62">What to expect</p>
        <h2 class="tt">What to expect. <span>Free, open, and kept up to date.</span></h2>
      </div>
      <div class="cells cells-3">
        {expect.map((e) => (
          <div class="cell">
            <h3 class="ct">{e.title}. <span>{e.body}</span></h3>
          </div>
        ))}
      </div>
    </section>

    <!-- ================================================================ team -->
    <section id="team" class="sec" data-space={spaceOf("team")}>
      <div class="sec-head sec-head-center">
        <p class="tag" style="--c:#d9673a">Who maintains it</p>
        <h2 class="statement">Claude. Codex. And&nbsp;Nik.</h2>
        <p class="statement-sub">Two AI agents write and maintain Airc. One human decides what ships.</p>
      </div>
      <div class="cells cells-3">
        {maintainers.map((m) => (
          <div class={`cell who who-${m.key}`}>
            {m.logo ? (
              <img class="who-icon" src={m.logo.src} width="40" height="40" alt="" />
            ) : (
              <Image class="who-icon who-photo" src={nikPhoto} alt="Nik" width={40} height={40} densities={[1, 2, 3]} format="webp" />
            )}
            <p class="who-name"><b>{m.name}</b> {m.role}</p>
            <p class="who-body">{m.body}</p>
          </div>
        ))}
      </div>
      {GITHUB_URL && (
      <a class="repo" href={GITHUB_URL} rel="noopener" data-gh data-track="github_clicked" data-track-from="team">
        <span class="repo-mark"><GitHubMark size={22} /></span>
        <span class="repo-copy">
          <b>{GITHUB_URL.replace("https://github.com/", "")}</b>
          <span>Every commit is public, Claude's and Codex's included. Apache-2.0.</span>
        </span>
        <span class="repo-stars"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 1.3l2 4.2 4.6.6-3.400 3.200.9 4.500L8 11.600 3.900 13.800l.9-4.500L1.400 6.100 6 5.500z" /></svg><b data-gh-stars></b> <span>Star</span></span>
      </a>
      )}
    </section>

    <!-- ================================================================ questions -->
    <section id="qa" class="sec qa-sec" data-space={spaceOf("qa")}>
      <div class="qa-head">
        <h2 class="tt">Questions. <span>And answers.</span></h2>
        <p class="qa-note">Anything else? <a href="mailto:hello@aircbrowser.com">hello@aircbrowser.com</a></p>
      </div>
      <div class="qa">
        {faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- ================================================================ closing (dark) -->
    <section id="closing" class="closing" data-space="pink">
      <div class="arc-glow" aria-hidden="true"><i></i><i></i></div>
      <div class="closing-count"><Countdown /></div>
      <h2><span class="red">Arc stops on December&nbsp;22.</span><br />Your Arc doesn't have&nbsp;to.</h2>
      <div class="join"><Download dark from="closing" /></div>
    </section>
  </div>
</Layout>

<script>
  import { track as send } from "../lib/analytics";
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

  // The loop's cards fill in row by row, once, when they come into view.
  const reveal = new IntersectionObserver(
    (entries) => {
      for (const e of entries)
        if (e.isIntersecting) {
          e.target.classList.add("in");
          reveal.unobserve(e.target);
        }
    },
    { threshold: 0.4 },
  );
  document.querySelectorAll("[data-in]").forEach((el) => reveal.observe(el));

  // ------------------------------------------------------------------ Spaces demo: swipe, drag, keys, tabs, autoplay
  const demo = document.querySelector<HTMLElement>("[data-spaces]");
  if (demo) {
    const view = demo.querySelector<HTMLElement>(".demo-view")!;
    const track = demo.querySelector<HTMLElement>(".demo-track")!;
    const tabs = [...demo.querySelectorAll<HTMLButtonElement>("[data-go]")];
    const slides = [...demo.querySelectorAll<HTMLElement>(".demo-slide")];
    const dots = [...demo.querySelectorAll<HTMLElement>(".demo-dots span")];
    const colours = tabs.map((t) => t.style.getPropertyValue("--c"));
    const n = slides.length;
    let i = 0;
    let auto: number | undefined;
    let touched = false;

    const show = (next: number, animate = true) => {
      i = (next + n) % n;
      track.style.transition = animate && !reduce ? "" : "none";
      track.style.transform = `translateX(${-100 * i}%)`;
      demo.dataset.active = String(i);
      demo.style.setProperty("--accent-space", colours[i]);
      tabs.forEach((t, k) => t.setAttribute("aria-selected", String(k === i)));
      slides.forEach((s, k) => s.setAttribute("aria-hidden", String(k !== i)));
      dots.forEach((d, k) => d.classList.toggle("on", k === i));
    };
    const used = new Set<string>();
    const usedBy = (method: string) => {
      if (used.has(method)) return;
      used.add(method);
      send("spaces_demo_used", { method });
    };
    const stopAuto = () => {
      touched = true;
      if (auto) clearInterval(auto);
      auto = undefined;
    };

    tabs.forEach((t) => t.addEventListener("click", () => { stopAuto(); usedBy("tab"); show(Number(t.dataset.go)); }));

    view.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") { stopAuto(); usedBy("keys"); show(i + 1); e.preventDefault(); }
      if (e.key === "ArrowLeft") { stopAuto(); usedBy("keys"); show(i - 1); e.preventDefault(); }
    });

    // Dragging: the track follows the pointer, and lets go with a spring.
    let startX = 0;
    let dx = 0;
    let dragging = false;
    view.addEventListener("pointerdown", (e) => {
      if (e.button !== 0) return;
      dragging = true;
      startX = e.clientX;
      dx = 0;
      stopAuto();
      track.style.transition = "none";
      view.setPointerCapture(e.pointerId);
      view.classList.add("dragging");
    });
    view.addEventListener("pointermove", (e) => {
      if (!dragging) return;
      dx = e.clientX - startX;
      const edge = (i === 0 && dx > 0) || (i === n - 1 && dx < 0) ? 0.35 : 1; // rubber band at the ends
      track.style.transform = `translateX(calc(${-100 * i}% + ${dx * edge}px))`;
    });
    const end = () => {
      if (!dragging) return;
      dragging = false;
      view.classList.remove("dragging");
      const w = view.clientWidth;
      if (Math.abs(dx) > 8) usedBy("drag");
      if (dx < -w * 0.15 && i < n - 1) show(i + 1);
      else if (dx > w * 0.15 && i > 0) show(i - 1);
      else show(i);
    };
    view.addEventListener("pointerup", end);
    view.addEventListener("pointercancel", end);

    // Two fingers on a trackpad: horizontal wheel events, the way Arc switches Spaces.
    let acc = 0;
    let locked = false;
    view.addEventListener(
      "wheel",
      (e) => {
        if (Math.abs(e.deltaX) <= Math.abs(e.deltaY)) return;
        e.preventDefault();
        if (locked) return;
        acc += e.deltaX;
        if (Math.abs(acc) > 40) {
          stopAuto();
          usedBy("swipe");
          show(i + (acc > 0 ? 1 : -1));
          acc = 0;
          locked = true;
          setTimeout(() => (locked = false), 650);
        }
      },
      { passive: false },
    );

    // A gentle demonstration while it's on screen, until someone touches it.
    if (!reduce) {
      new IntersectionObserver(
        ([entry]) => {
          if (touched) return;
          if (entry.isIntersecting && !auto) auto = window.setInterval(() => show(i + 1), 3600);
          if (!entry.isIntersecting && auto) { clearInterval(auto); auto = undefined; }
        },
        { threshold: 0.5 },
      ).observe(view);
    }
    show(0, false);
  }

  // ------------------------------------------------------------------ Boosts: Colors, Font, Zap
  const boost = document.querySelector<HTMLElement>("[data-boost]");
  if (boost) {
    const tabsB = [...boost.querySelectorAll<HTMLButtonElement>("[data-mode]")];
    const shotsB = [...boost.querySelectorAll<HTMLElement>("[data-shot]")];
    let k = 0;
    let timer: number | undefined;
    let taken = false;
    const pick = (n: number) => {
      k = n;
      tabsB.forEach((t, j) => t.setAttribute("aria-selected", String(j === n)));
      shotsB.forEach((sh, j) => {
        sh.classList.toggle("on", j === n);
        sh.setAttribute("aria-hidden", String(j !== n));
        sh.tabIndex = j === n ? 0 : -1;
      });
      // restart the progress bar on the chosen tab
      boost.classList.remove("ticking");
      void boost.offsetWidth;
      if (timer) boost.classList.add("ticking");
    };
    tabsB.forEach((t, j) =>
      t.addEventListener("click", () => {
        taken = true;
        if (timer) clearInterval(timer);
        timer = undefined;
        boost.classList.remove("ticking");
        pick(j);
        send("boosts_mode", { mode: t.querySelector("b")?.textContent ?? "" });
      }),
    );
    if (!reduce) {
      new IntersectionObserver(
        ([e]) => {
          if (taken) return;
          if (e.isIntersecting && !timer) {
            timer = window.setInterval(() => pick((k + 1) % tabsB.length), 4200);
            boost.classList.add("ticking");
          } else if (!e.isIntersecting && timer) {
            clearInterval(timer);
            timer = undefined;
            boost.classList.remove("ticking");
          }
        },
        { threshold: 0.5 },
      ).observe(boost);
    }
  }

  // ------------------------------------------------------------------ the hero post expands
  const post = document.querySelector<HTMLElement>("[data-post]");
  const expand = document.querySelector<HTMLElement>("[data-expand]");
  expand?.addEventListener("click", () => {
    send("post_expanded");
    post?.classList.add("open");
    expand.setAttribute("aria-expanded", "true");
  });
  document.querySelector("[data-collapse]")?.addEventListener("click", () => {
    post?.classList.remove("open");
    expand?.setAttribute("aria-expanded", "false");
    document.getElementById("tweet")?.scrollIntoView({ behavior: reduce ? "auto" : "smooth", block: "start" });
  });

  // ------------------------------------------------------------------ feature explorer: the tab list follows the panes
  const exTabs = [...document.querySelectorAll<HTMLAnchorElement>("[data-pane]")];
  const panes = [...document.querySelectorAll<HTMLElement>(".pane")];
  if (exTabs.length) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          exTabs.forEach((t) => t.classList.toggle("on", t.dataset.pane === e.target.id));
        }
      },
      { rootMargin: "-40% 0px -55% 0px" },
    );
    panes.forEach((p) => io.observe(p));

    // How far through the active pane you've read fills its tab's bar.
    const scroller = matchMedia("(min-width: 901px)").matches ? document.querySelector<HTMLElement>("#page") : null;
    const progress = () => {
      const mid = innerHeight * 0.45;
      for (const p of panes) {
        const r = p.getBoundingClientRect();
        const f = Math.min(1, Math.max(0, (mid - r.top) / r.height));
        exTabs.find((t) => t.dataset.pane === p.id)?.style.setProperty("--p", String(f));
      }
    };
    (scroller ?? window).addEventListener("scroll", () => requestAnimationFrame(progress), { passive: true });
    progress();
    exTabs.forEach((t) =>
      t.addEventListener("click", (e) => {
        e.preventDefault();
        document.getElementById(t.dataset.pane!)?.scrollIntoView({ behavior: reduce ? "auto" : "smooth", block: "start" });
        history.pushState(null, "", `#${t.dataset.pane}`);
      }),
    );
  }
</script>

<style>
  /* ------------------------------------------------------------------ the grid: hairline columns, sections as rows */

  .grid {
    --pad: clamp(20px, 4vw, 56px);
    max-width: 1120px;
    margin: 0 auto;
    box-shadow: 1px 0 0 var(--hl), -1px 0 0 var(--hl);
  }

  .grid > section + section { box-shadow: 0 -1px 0 var(--hl); }

  .red { color: var(--red); }
  .nowrap { white-space: nowrap; }

  /* Two-tone type: the lead in ink, the rest in grey. */
  .tt {
    max-width: 820px;
    font-size: clamp(30px, 3.4vw, 44px);
    line-height: 1.1;
    font-weight: 550;
    letter-spacing: -0.022em;
    color: var(--t1);
    text-wrap: balance;
  }

  /* The continuation half of a two-tone heading: grey, but readable (Attio's #747d8b). */
  .grid { --cont: #7a8190; }

  @media (prefers-color-scheme: dark) {
    .grid { --cont: #a0a6b2; }
  }

  .tt span,
  .ct span,
  .pt span { color: var(--cont); }

  .ct {
    font-size: 18px;
    line-height: 1.4;
    font-weight: 550;
    letter-spacing: -0.012em;
    color: var(--t1);
    text-wrap: pretty;
  }

  /* Tags take the colour of their section's sidebar icon (Attio's tinted pills). */
  .tag {
    --c: var(--t3);
    display: inline-flex;
    align-items: center;
    height: 24px;
    margin-bottom: 18px;
    padding: 0 9px;
    border-radius: 7px;
    font-size: 12.5px;
    font-weight: 600;
    color: color-mix(in srgb, var(--c) 78%, #000);
    background: color-mix(in srgb, var(--c) 11%, var(--bg));
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--c) 22%, transparent);
  }

  @media (prefers-color-scheme: dark) {
    .tag { color: color-mix(in srgb, var(--c) 70%, #fff); background: color-mix(in srgb, var(--c) 16%, var(--bg)); }
  }

  .sec { padding: clamp(56px, 7vw, 96px) 0 0; }
  .sec-head { padding: 0 var(--pad) clamp(32px, 4vw, 48px); }

  .sec-head-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
  }

  .sec-head-center { display: flex; flex-direction: column; align-items: center; text-align: center; }

  .statement {
    font-size: clamp(38px, 4.6vw, 60px);
    line-height: 1.02;
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--t1);
  }

  .statement-sub { margin-top: 14px; max-width: 460px; font-size: 18px; line-height: 1.45; font-weight: 500; color: var(--cont); text-wrap: balance; }

  .cells {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    box-shadow: 0 -1px 0 var(--hl);
  }

  .cells-2 { grid-template-columns: 1fr 1fr; }
  .cells-3 { grid-template-columns: repeat(3, 1fr); }

  .cell {
    padding: clamp(28px, 3.2vw, 40px) var(--pad);
    min-height: 100%;
  }

  .cell + .cell { box-shadow: -1px 0 0 var(--hl); }

  .source { margin-top: 20px; font-size: 12.5px; font-weight: 500; color: var(--t3); }
  .source a { color: var(--t2); text-decoration: underline; text-decoration-color: var(--hl-strong); text-underline-offset: 3px; }
  .source a:hover { color: var(--t1); }
  #math .cell:first-child { display: grid; align-content: center; }

  .kicker {
    margin-top: 28px;
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.012em;
    color: var(--t1);
  }

  /* ------------------------------------------------------------------ hero */

  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: clamp(56px, 7vw, 96px) var(--pad) 0;
    text-align: center;
    overflow: hidden;
  }

  /* Attio's faint wash behind the product frame, in Arc's colours. */
  /* Arc's aurora behind the story, at about a third of Arc's own strength, so Attio's restraint holds. */
  .hero-glow {
    position: absolute;
    inset: 0 -10% 0;
    z-index: -1;
    --a: 34%;
    background:
      radial-gradient(42% 46% at 14% 10%, color-mix(in srgb, var(--mint) var(--a), transparent), transparent 72%),
      radial-gradient(40% 44% at 50% -6%, color-mix(in srgb, var(--sky) var(--a), transparent), transparent 72%),
      radial-gradient(42% 48% at 88% 12%, color-mix(in srgb, var(--lilac) var(--a), transparent), transparent 72%),
      radial-gradient(50% 50% at 30% 72%, color-mix(in srgb, var(--mint) 18%, transparent), transparent 70%),
      radial-gradient(50% 50% at 72% 70%, color-mix(in srgb, var(--pink) 20%, transparent), transparent 70%);
    -webkit-mask-image: linear-gradient(#000 70%, transparent);
    mask-image: linear-gradient(#000 70%, transparent);
  }

  @media (prefers-color-scheme: dark) {
    .hero-glow { --a: 22%; opacity: 0.85; }
  }

  .hero-copy { display: flex; flex-direction: column; align-items: center; }

  h1 {
    margin-top: 24px;
    max-width: 920px;
    font-size: clamp(40px, 5.4vw, 72px);
    line-height: 1.02;
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--t1);
    text-wrap: balance;
  }

  .sub {
    max-width: 560px;
    margin-top: 22px;
    font-size: clamp(17px, 1.4vw, 19px);
    line-height: 1.45;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--t2);
    text-wrap: balance;
  }

  .sub strong { font-weight: 600; color: var(--t1); }

  .join { display: flex; justify-content: center; width: 100%; margin-top: 28px; scroll-margin-top: 120px; }

  .meta { margin-top: 12px; font-size: 13px; font-weight: 500; color: var(--t2); }

  .pointer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    margin-top: clamp(28px, 3vw, 40px);
    font-size: 13px;
    font-weight: 600;
    color: var(--red);
  }

  .pointer svg {
    width: 26px;
    height: 38px;
    overflow: visible;
    fill: none;
    stroke: currentColor;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (prefers-reduced-motion: no-preference) {
    .arrow-line { stroke-dasharray: 1; stroke-dashoffset: 1; animation: draw 0.9s var(--ease-out) 0.5s forwards; }
    .arrow-head { opacity: 0; animation: fade 0.25s ease-out 1.25s forwards; }
  }

  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes fade { to { opacity: 1; } }

  /* A window frame for the product (Attio's light chrome with traffic lights). */
  .frame {
    width: 100%;
    border-radius: 14px;
    background: #f1f1f3;
    box-shadow: inset 0 0 0 1px var(--hl-strong), 0 24px 48px -24px rgb(20 20 40 / 0.18);
    text-align: left;
  }

  @media (prefers-color-scheme: dark) {
    .frame { background: #1b1b1e; box-shadow: inset 0 0 0 1px var(--hl-strong), 0 24px 48px -24px rgb(0 0 0 / 0.6); }
  }

  .frame-bar {
    display: flex;
    align-items: center;
    gap: 14px;
    height: 40px;
    padding: 0 14px;
  }

  .lights { display: flex; gap: 7px; }
  .lights i { width: 11px; height: 11px; border-radius: 50%; background: #ff5f57; }
  .lights i:nth-child(2) { background: #febc2e; }
  .lights i:nth-child(3) { background: #28c840; }

  .frame-url {
    flex: 1;
    max-width: 380px;
    overflow: hidden;
    padding: 4px 10px;
    border-radius: 7px;
    font-size: 12px;
    font-weight: 500;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--t2);
    background: rgb(var(--ink) / 0.05);
  }

  .frame-body {
    margin: 0 6px 6px;
    padding: clamp(16px, 3vw, 36px);
    border-radius: 10px;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--hl);
  }

  .hero-frame {
    max-width: 760px;
    margin-top: 10px;
    margin-bottom: -2px;
    border-radius: 14px 14px 0 0;
    scroll-margin-top: 24px;
  }

  .hero-frame .frame-body { border-radius: 10px 10px 0 0; margin-bottom: 0; }
  .hero-frame .frame-body > :global(figure) { max-width: 600px; margin: 0 auto; }

  /* The post is long: it shows its top, and expands on request. */
  .post { position: relative; max-height: 440px; overflow: hidden; transition: max-height 0.6s var(--spring-settle); }
  .post.open { max-height: 1600px; }

  .post-more {
    position: absolute;
    inset: auto 0 0;
    display: flex;
    justify-content: center;
    align-items: flex-end;
    height: 160px;
    padding-bottom: 24px;
    background: linear-gradient(to bottom, transparent, var(--surface) 70%);
    transition: opacity 0.3s ease;
  }

  .post.open .post-more { opacity: 0; pointer-events: none; }

  .post-less { display: none; justify-content: center; gap: 8px; margin-top: 8px; }
  .post.open .post-less { display: flex; }

  /* ------------------------------------------------------------------ facts (Attio's logo grid) */

  .facts {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
  }

  .fact {
    display: grid;
    gap: 4px;
    padding: 26px 22px;
    text-align: center;
  }

  .fact + .fact { box-shadow: -1px 0 0 var(--hl); }
  .fact b { font-size: 17px; font-weight: 600; letter-spacing: -0.015em; color: var(--t1); font-variant-numeric: tabular-nums; }
  .fact span { font-size: 13px; font-weight: 500; color: var(--t3); }
  a.fact:hover span { color: var(--t1); }

  /* ------------------------------------------------------------------ the math: orbit */

  .orbit-cell { display: grid; place-items: center; background: var(--panel); }

  .orbit {
    position: relative;
    width: min(100%, 420px);
    aspect-ratio: 1.25;
  }

  .ring {
    position: absolute;
    left: 50%;
    top: 50%;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    box-shadow: inset 0 0 0 1px var(--hl-strong);
  }

  .r1 { width: 46%; aspect-ratio: 1; }
  .r2 { width: 78%; aspect-ratio: 1; }

  .core {
    position: absolute;
    left: 50%;
    top: 50%;
    display: grid;
    place-items: center;
    width: 84px;
    height: 84px;
    border-radius: 50%;
    background: var(--surface);
    transform: translate(-50%, -50%);
    box-shadow: 0 0 0 1px var(--hl), 0 8px 24px -8px rgb(20 20 40 / 0.2);
  }

  .core :global(img) { width: 52px; height: 52px; }

  .chip {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 9px;
    border-radius: 8px;
    font-size: 12.5px;
    font-weight: 600;
    white-space: nowrap;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--hl-strong), 0 2px 6px -2px rgb(20 20 40 / 0.12);
  }

  .chip img,
  .chip :global(img) { width: 14px; height: 14px; border-radius: 50%; }

  .chip-claude { left: 0; top: 12%; color: #b4532a; background: #fdf1ea; box-shadow: inset 0 0 0 1px #f3d6c6; }
  .chip-codex { right: 0; top: 30%; color: #4447c9; background: #eef0ff; box-shadow: inset 0 0 0 1px #d6dbff; }
  .chip-chromium { left: 6%; bottom: 18%; color: #1f7a4f; background: #eaf8f0; box-shadow: inset 0 0 0 1px #c9ecd8; font-variant-numeric: tabular-nums; }
  .chip-nik { right: 8%; bottom: 8%; color: var(--t1); }

  @media (prefers-color-scheme: dark) {
    .chip-claude { color: #f0a27a; background: #2a1c15; box-shadow: inset 0 0 0 1px #4a2c1e; }
    .chip-codex { color: #a9adff; background: #1b1c33; box-shadow: inset 0 0 0 1px #2e3160; }
    .chip-chromium { color: #7fd7a6; background: #142a1f; box-shadow: inset 0 0 0 1px #224634; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .chip { animation: float 6s ease-in-out infinite; }
    .chip-codex { animation-delay: -1.5s; }
    .chip-chromium { animation-delay: -3s; }
    .chip-nik { animation-delay: -4.5s; }
  }

  @keyframes float { 50% { transform: translateY(-5px); } }

  /* ------------------------------------------------------------------ the loop */

  .step { display: grid; align-content: start; gap: 18px; }

  .step-n {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 9px;
    font-size: 13px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--t2);
    background: var(--panel);
    box-shadow: inset 0 0 0 1px var(--hl-strong);
  }

  /* ------------------------------------------------------------------ the Spaces demo */

  .demo {
    --accent-space: #53ca9f;
    padding: 0 var(--pad) clamp(40px, 5vw, 64px);
  }

  .demo-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 16px;
  }

  .seg {
    display: inline-flex;
    gap: 2px;
    padding: 3px;
    border-radius: 11px;
    background: var(--panel);
    box-shadow: inset 0 0 0 1px var(--hl);
  }

  .seg-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 30px;
    padding: 0 12px;
    border: 0;
    border-radius: 8px;
    font: inherit;
    font-size: 13.5px;
    font-weight: 550;
    color: var(--t2);
    background: transparent;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease, box-shadow 0.2s ease;
  }

  .seg-btn i { width: 8px; height: 8px; border-radius: 50%; background: var(--c); }
  .seg-btn:hover { color: var(--t1); }

  .seg-btn[aria-selected="true"] {
    color: var(--t1);
    background: var(--surface);
    box-shadow: 0 0 0 1px var(--hl-strong), 0 1px 2px rgb(0 0 0 / 0.06);
  }

  .demo-hint { font-size: 13px; font-weight: 500; color: var(--t2); }

  .demo-view {
    position: relative;
    overflow: hidden;
    border-radius: 16px;
    background: var(--panel);
    box-shadow: 0 0 0 0.5px rgb(var(--ink) / 0.1), 0 24px 50px -30px rgb(30 25 50 / 0.4);
    padding: 0;
    cursor: grab;
    touch-action: pan-y;
    user-select: none;
    transition: background-color 0.5s var(--spring-settle);
  }

  .demo-view.dragging { cursor: grabbing; }
  .demo-view:focus-visible { outline: 2px solid var(--t1); outline-offset: 3px; }

  .demo-track {
    display: flex;
    transition: transform 0.48s var(--spring-settle);
    will-change: transform;
  }

  .demo-slide { flex: 0 0 100%; }

  .demo-slide :global(img) {
    display: block;
    width: 100%;
    height: auto;
    pointer-events: none;
  }

  .demo-dots { display: flex; justify-content: center; gap: 8px; margin-top: 16px; }

  .demo-dots span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--hl-strong);
    transition: background-color 0.3s ease, transform 0.3s var(--spring-settle);
  }

  .demo-dots span.on { background: var(--c); transform: scale(1.35); }

  /* ------------------------------------------------------------------ feature explorer: sticky tabs beside the panes */

  .explorer {
    display: grid;
    grid-template-columns: 228px minmax(0, 1fr);
  }

  .ex-tabs {
    position: sticky;
    top: 0;
    align-self: start;
    display: grid;
    gap: 2px;
    padding: 48px 0 48px var(--pad);
  }

  .ex-tabs a {
    position: relative;
    display: grid;
    gap: 1px;
    padding: 9px 0 9px 16px;
    transition: color 0.2s ease;
  }

  .ex-tabs b { font-size: 14.5px; font-weight: 550; letter-spacing: -0.01em; color: var(--t3); transition: color 0.2s ease; }
  .ex-tabs span { padding-right: 12px; font-size: 12.5px; line-height: 16px; font-weight: 500; color: var(--t3); opacity: 0; max-height: 0; overflow: hidden; transition: opacity 0.25s ease, max-height 0.3s var(--spring-settle); }

  /* The rail: a hairline, and on the active tab a bar that fills as you read its pane (Attio's progress rail). */
  .ex-tabs a::before {
    content: "";
    position: absolute;
    left: 0;
    top: 6px;
    bottom: 6px;
    width: 2px;
    border-radius: 2px;
    background: var(--hl);
  }

  .prog {
    position: absolute;
    left: 0;
    top: 6px;
    width: 2px;
    height: 0;
    border-radius: 2px;
    background: #3b82f6;
  }

  .ex-tabs a:hover b { color: var(--t2); }
  .ex-tabs a.on b { color: var(--t1); }
  .ex-tabs a.on span { opacity: 1; max-height: 34px; color: var(--t2); }
  .ex-tabs a.on .prog { height: calc((100% - 12px) * var(--p, 0)); }

  .ex-panes { box-shadow: -1px 0 0 var(--hl); }

  .pane {
    padding: 48px clamp(20px, 3vw, 40px);
    scroll-margin-top: 0;
  }

  .pane + .pane { box-shadow: 0 -1px 0 var(--hl); }

  .pt {
    max-width: 620px;
    font-size: clamp(22px, 2vw, 26px);
    line-height: 1.25;
    font-weight: 550;
    letter-spacing: -0.018em;
    color: var(--t1);
    text-wrap: pretty;
  }

  /* Screenshots sit on a soft desktop: no frame of their own, so the window's corners are the only corners. */
  .pane-demo {
    display: block;
    width: 100%;
    margin-top: 28px;
    padding: clamp(20px, 3.4vw, 44px);
    border: 0;
    border-radius: 16px;
    background:
      radial-gradient(80% 90% at 0% 0%, color-mix(in srgb, var(--mint) 26%, transparent), transparent 70%),
      radial-gradient(80% 90% at 100% 100%, color-mix(in srgb, var(--lilac) 28%, transparent), transparent 70%),
      var(--panel);
    font: inherit;
    color: inherit;
    text-align: left;
  }

  @media (prefers-color-scheme: dark) {
    .pane-demo {
      background:
        radial-gradient(80% 90% at 0% 0%, color-mix(in srgb, var(--mint) 12%, transparent), transparent 70%),
        radial-gradient(80% 90% at 100% 100%, color-mix(in srgb, var(--lilac) 14%, transparent), transparent 70%),
        var(--panel);
    }
  }

  /* The marketing shots are the window, its shadow and a soft desktop: shown as they are, just rounded. */
  .pane-demo.shot,
  .pane-demo .shot-flat { padding: 0; overflow: hidden; background: none; }

  .shot :global(img) { border-radius: 14px; }

  .pane-demo.shot :global(img),
  .shot-flat :global(img) {
    filter: none !important;
    box-shadow: 0 0 0 0.5px rgb(var(--ink) / 0.1), 0 18px 40px -24px rgb(30 25 50 / 0.35);
  }

  .tint-demo { padding: 20px 20px 18px; margin-bottom: 14px; }
  .pane-cmd { padding: 0; background: none; }
  .pane-cmd .try { margin-top: 14px; }

  /* (Older captures, for reference: they carried transparent window corners and a following shadow.) */
  .grid { --window-shadow: drop-shadow(0 0 0.5px rgb(0 0 0 / 0.35)) drop-shadow(0 18px 28px rgb(30 25 50 / 0.2)); }

  @media (prefers-color-scheme: dark) {
    .grid { --window-shadow: drop-shadow(0 0 0.5px rgb(255 255 255 / 0.25)) drop-shadow(0 18px 30px rgb(0 0 0 / 0.55)); }
  }

  .shot { cursor: zoom-in; }

  .shot :global(img) {
    display: block;
    width: 100%;
    height: auto;
    filter: var(--window-shadow);
    transition: transform 0.35s var(--spring-settle);
  }

  .shot:hover :global(img) { transform: translateY(-2px); }

  .shot-flat {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
  }

  .try {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 34px;
    margin-top: 16px;
    padding: 0 8px 0 12px;
    border: 0;
    border-radius: 9px;
    font: inherit;
    font-size: 13.5px;
    font-weight: 550;
    color: var(--t1);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--hl-strong), 0 1px 2px rgb(0 0 0 / 0.04);
    cursor: pointer;
  }

  .note {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 14px;
    font-size: 13px;
    font-weight: 500;
    color: var(--t2);
  }

  .note i { width: 6px; height: 6px; border-radius: 50%; background: #e0a030; }
  .note:hover { color: var(--t1); }

  .try:hover { box-shadow: inset 0 0 0 1px var(--t3), 0 1px 2px rgb(0 0 0 / 0.06); }
  .try kbd { margin: 0; }





  /* ------------------------------------------------------------------ what works: a table */

  .run {
    display: flex;
    gap: 10px;
    flex: none;
    font-size: 13px;
    line-height: 1.5;
    font-weight: 500;
    color: var(--t2);
  }

  .run b { color: var(--t1); }
  .run code { font-family: var(--mono); font-size: 12px; }

  .run-dot {
    flex: none;
    width: 7px;
    height: 7px;
    margin-top: 6px;
    border-radius: 50%;
    background: #2f9e62;
    box-shadow: 0 0 0 3px rgb(47 158 98 / 0.2);
  }

  .table { box-shadow: 0 -1px 0 var(--hl); }

  .tr {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 160px;
    align-items: center;
    gap: 24px;
    padding: 14px var(--pad);
  }

  .tr + .tr { box-shadow: 0 -1px 0 var(--hl); }
  .tr:not(.th):hover { background: var(--panel); }

  .th {
    padding-block: 10px;
    font-size: 12.5px;
    font-weight: 550;
    color: var(--t3);
    background: var(--panel);
  }

  .th span:last-child,
  .td-s { justify-self: end; }

  .td-f { display: grid; gap: 2px; }
  .td-f b { font-size: 15px; font-weight: 600; letter-spacing: -0.01em; color: var(--t1); }
  .td-f span { font-size: 14px; font-weight: 500; color: var(--t2); }

  .mark {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    color: #fff;
  }

  .mark svg { width: 13px; height: 13px; fill: none; stroke: currentColor; stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
  .mark-passing { background: #2f9e62; }
  .mark-failing { background: #e5484d; }

  .pending {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 24px;
    padding: 0 9px;
    border-radius: 7px;
    font-size: 12.5px;
    font-weight: 550;
    color: #93610f;
    background: #fdf6e6;
    box-shadow: inset 0 0 0 1px #f3e2b8;
  }

  .pending i { width: 6px; height: 6px; border-radius: 50%; background: #e0a030; }

  @media (prefers-color-scheme: dark) {
    .pending { color: #f0c26b; background: #2b2213; box-shadow: inset 0 0 0 1px #4a3a1c; }
  }

  /* ------------------------------------------------------------------ why */

  .why { padding: clamp(56px, 7vw, 96px) var(--pad); }




  /* ------------------------------------------------------------------ team */

  .who { display: grid; align-content: start; gap: 12px; }
  .who-icon { width: 40px; height: 40px; }
  .who :global(.who-photo) { border-radius: 50%; box-shadow: 0 0 0 1px var(--hl-strong); }
  .who-name { margin-top: 6px; font-size: 14px; font-weight: 500; color: var(--t3); }
  .who-name b { margin-right: 6px; font-size: 17px; font-weight: 600; letter-spacing: -0.015em; color: var(--t1); }
  .who-body { font-size: 15px; line-height: 1.5; font-weight: 500; color: var(--t2); }

  /* ------------------------------------------------------------------ questions */

  .qa-sec {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: 40px;
    padding: clamp(56px, 7vw, 96px) var(--pad);
  }

  .qa-head { position: sticky; top: 24px; align-self: start; }
  .qa-note { margin-top: 14px; font-size: 15px; font-weight: 500; color: var(--t2); }
  .qa-note a { color: var(--t1); text-decoration: underline; text-decoration-color: var(--hl-strong); text-underline-offset: 3px; }

  .qa { box-shadow: 0 1px 0 var(--hl); }
  .qa details { box-shadow: 0 -1px 0 var(--hl); }

  .qa summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 18px 0;
    font-size: 16px;
    font-weight: 550;
    letter-spacing: -0.01em;
    color: var(--t1);
    cursor: pointer;
    list-style: none;
  }

  .qa summary::-webkit-details-marker { display: none; }

  .qa summary::after {
    content: "";
    flex: none;
    width: 12px;
    height: 12px;
    background:
      linear-gradient(var(--t3), var(--t3)) center / 100% 1.5px no-repeat,
      linear-gradient(var(--t3), var(--t3)) center / 1.5px 100% no-repeat;
    transition: transform 0.25s var(--ease-out);
  }

  .qa details[open] summary::after { transform: rotate(45deg); }
