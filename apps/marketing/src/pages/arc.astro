---
// /arc: every Arc feature, grouped as Arc's areas, with its status in Airc, where it is and since which release.
// Data: src/data/arc-parity.json, generated by scripts/arc-parity.mjs from the parity ledger (docs/qa/parity-audit.md)
// and the public words in scripts/arc-parity-copy.json. A row counts as released only once its version is published
// (the same list /features uses); until then it says "Coming in the next update".
import Layout from "../layouts/Layout.astro";
import Download from "../components/Download.astro";
import data from "../data/arc-parity.json";
import { getPublished } from "../lib/release";
import { CONTACT_EMAIL } from "../lib/site";

type Status = "works" | "partly" | "not-yet" | "wont" | "next";
interface Row { slug: string; arc: string; status: string; where: string; note: string; since: string | null }

const published = await getPublished();
const shownStatus = (r: Row): Status => {
  if ((r.status === "works" || r.status === "partly") && (!r.since || r.since === "next" || !published.has(r.since))) return "next";
  return r.status as Status;
};
const areas = data.areas.map((a) => ({ ...a, rows: (a.rows as Row[]).map((r) => ({ ...r, shown: shownStatus(r) })) }));
const all = areas.flatMap((a) => a.rows);
const count = (s: Status) => all.filter((r) => r.shown === s).length;
const LABEL: Record<Status, string> = { works: "Works", partly: "Partly", "not-yet": "Not yet", wont: "Won't do", next: "Next update" };
const counts = (["works", "partly", "next", "not-yet", "wont"] as Status[]).map((s) => ({ s, n: count(s) })).filter((c) => c.n);

const checked = new Date(`${data.checked}T12:00:00Z`).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });

// What a reply or a search result reads: one sentence per feature.
const answer = (r: (typeof all)[number]) => {
  const where = r.where && r.where !== "—" ? ` In Airc: ${r.where}.` : "";
  const since = r.since && r.shown !== "next" ? ` Since Airc ${r.since}.` : "";
  const note = r.note ? ` ${r.note}` : "";
  switch (r.shown) {
    case "works": return `Yes.${where}${note}${since}`;
    case "partly": return `Partly.${note}${where}${since}`;
    case "next": return `It's coming in the next Airc update.${where}${note}`;
    case "not-yet": return `Not yet.${note}`;
    case "wont": return `No, by design.${note}`;
  }
};
const faq = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: all.map((r) => ({
    "@type": "Question",
    name: `Is Arc's “${r.arc}” in Airc?`,
    acceptedAnswer: { "@type": "Answer", text: answer(r) },
  })),
};
---

<Layout
  title="Every Arc feature, and where it is in Airc"
  description={`Arc ends on December 22. Here is every Arc feature, from Spaces and the Command Bar to Little Arc, Boosts, Easels and Max, with what works in Airc, what partly works, what's missing, and where to find each one.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(faq)} />
  <article class="arc">
    <header class="head">
      <p class="tag">Arc → Airc</p>
      <h1>Every Arc feature, and where it is in Airc.</h1>
      <p class="lede">
        Arc ends on December 22. If you're deciding where your Arc habits go next, this is the whole list: each Arc
        feature in Arc's own words, whether Airc has it, where to find it, and the version that brought it. What's
        missing is listed too.
      </p>
      <ul class="sum" aria-label="Summary">
        {counts.map(({ s, n }) => (
          <li><span class={`pill pill-${s}`}>{LABEL[s]}</span> {n}</li>
        ))}
      </ul>
      <p class="checked">Checked {checked}. Only features in a published release count as Works.</p>
    </header>

    <nav class="jump" aria-label="Arc's areas">
      {areas.map((a) => <a href={`#${a.id}`}>{a.name}</a>)}
    </nav>

    {areas.map((a) => (
      <section class="area" id={a.id} aria-labelledby={`${a.id}-h`}>
        <h2 id={`${a.id}-h`}>{a.name}</h2>
        <ul class="rows">
          {a.rows.map((r) => (
            <li class={`row row-${r.shown}`} id={r.slug}>
              <div class="r-head">
                <h3><a href={`#${r.slug}`} class="anchor">{r.arc}</a></h3>
                <span class={`pill pill-${r.shown}`}>{r.shown === "next" ? "Coming in the next update" : LABEL[r.shown]}</span>
              </div>
              {r.where && r.where !== "—" && <p class="where"><span>In Airc</span>{r.where}</p>}
              {r.note && <p class="note">{r.note}</p>}
              {r.since && r.shown !== "next" && <p class="since">Since {r.since}</p>}
            </li>
          ))}
        </ul>
      </section>
    ))}

    <footer class="end">
      <p>
        Something you used in Arc that isn't here, or isn't right? Tell us: Help › Send Feedback… in Airc, or
        <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>. Everything Airc does, with screenshots, is on
        <a href="/features">Features</a>; what each release changed is in the <a href="/changelog">changelog</a>.
      </p>
      <Download from="arc" />
    </footer>
  </article>
</Layout>

<style>
  .arc {
    --pad: clamp(16px, 4vw, 56px);
    max-width: 1080px;
    margin: 0 auto;
    padding: clamp(48px, 7vw, 96px) 0 0;
  }

  .head { padding: 0 var(--pad); max-width: 820px; }

  .tag {
    display: inline-flex;
    align-items: center;
    height: 24px;
    margin-bottom: 18px;
    padding: 0 9px;
    border-radius: 7px;
    font-size: 12.5px;
    font-weight: 600;
    color: #8f2d2d;
    background: rgb(221 72 72 / 0.1);
    box-shadow: inset 0 0 0 1px rgb(221 72 72 / 0.2);
  }

  h1 {
    font-size: clamp(32px, 4vw, 52px);
    line-height: 1.06;
    font-weight: 550;
    letter-spacing: -0.026em;
    color: var(--t1);
    text-wrap: balance;
  }

  .lede { margin-top: 18px; font-size: clamp(16px, 1.4vw, 18.5px); line-height: 1.5; color: var(--t2); max-width: 680px; }

  .sum { display: flex; flex-wrap: wrap; gap: 8px 18px; margin: 22px 0 0; padding: 0; list-style: none; font-size: 15px; font-weight: 600; color: var(--t1); }
  .sum li { display: inline-flex; align-items: center; gap: 7px; }

  .checked { margin-top: 12px; font-size: 13.5px; color: var(--text-3); }

  .pill {
    flex: none;
    display: inline-flex;
    align-items: center;
    height: 22px;
    padding: 0 8px;
    border-radius: 7px;
    font-size: 12px;
    font-weight: 600;
    white-space: nowrap;
  }
  .pill-works { color: #1f7a4a; background: rgb(47 158 98 / 0.12); }
  .pill-partly { color: #8a5a00; background: rgb(232 163 43 / 0.16); }
  .pill-next { color: #5b3fc0; background: rgb(122 76 240 / 0.12); }
  .pill-not-yet { color: #a33030; background: rgb(221 72 72 / 0.12); }
  .pill-wont { color: #5d6470; background: rgb(93 100 112 / 0.12); }

  .jump {
    position: sticky;
    top: 0;
    z-index: 5;
    display: flex;
    gap: 4px;
    margin-top: clamp(28px, 4vw, 44px);
    padding: 10px var(--pad);
    overflow-x: auto;
    scrollbar-width: none;
    background: color-mix(in srgb, var(--bg) 86%, transparent);
    backdrop-filter: saturate(1.6) blur(14px);
    -webkit-backdrop-filter: saturate(1.6) blur(14px);
    box-shadow: 0 1px 0 var(--hl);
  }
  .jump::-webkit-scrollbar { display: none; }
  .jump a {
    flex: none;
    display: inline-flex;
    align-items: center;
    height: 30px;
    padding: 0 11px;
    border-radius: 9px;
    font-size: 13.5px;
    font-weight: 550;
    color: var(--t2);
  }
  .jump a:hover { color: var(--t1); background: var(--panel); }

  @media (max-width: 900px) {
    .jump { top: 56px; }
    .area, .row { scroll-margin-top: 110px; }
  }

  .area { padding: clamp(40px, 5vw, 64px) var(--pad) 0; scroll-margin-top: 54px; }

  .area h2 {
    margin-bottom: 14px;
    font-size: clamp(22px, 2.4vw, 30px);
    line-height: 1.15;
    font-weight: 550;
    letter-spacing: -0.02em;
    color: var(--t1);
  }

  .rows { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line); }

  .row { padding: 14px 0 15px; border-bottom: 1px solid var(--line); scroll-margin-top: 60px; }
  .row:target { background: color-mix(in srgb, var(--accent) 6%, transparent); box-shadow: -10px 0 0 color-mix(in srgb, var(--accent) 6%, transparent), 10px 0 0 color-mix(in srgb, var(--accent) 6%, transparent); }

  .r-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }

  h3 { font-size: 16px; line-height: 1.35; font-weight: 600; color: var(--t1); }
  .anchor { color: inherit; }
  .anchor:hover { color: var(--accent-text); }

  .where, .note, .since { margin-top: 4px; font-size: 14.5px; line-height: 1.45; }
  .where { color: var(--t1); }
  .where span { margin-right: 8px; font-size: 12px; font-weight: 600; letter-spacing: 0.02em; text-transform: uppercase; color: var(--text-3); }
  .note { color: var(--t2); }
  .since { font-size: 12.5px; color: var(--text-3); }

  @media (max-width: 560px) {
    .r-head { flex-direction: column; gap: 6px; }
  }

  .end { padding: clamp(48px, 6vw, 80px) var(--pad) clamp(48px, 6vw, 72px); max-width: 760px; }
  .end p { margin-bottom: 22px; font-size: 15px; line-height: 1.55; color: var(--t2); }
  .end a { color: var(--accent-text); }
</style>
