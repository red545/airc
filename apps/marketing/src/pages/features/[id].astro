---
// One page per feature group of /features (src/data/catalog.ts): the group's video from the social studio (frames
// Airc rendered itself, synced by scripts/sync-videos.mjs) in the window's frame, the two-tone headline, what it does,
// its features' own videos and its stills. A video shows in production once it says released and its release is
// published; a page, once its group has a released feature and a video that shows. Preview deployments show every
// group's page and every video, the next release's marked, with stills where no video is in yet.
import Layout from "../../layouts/Layout.astro";
import Download from "../../components/Download.astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { groups, shotAlt, shown, type Feature } from "../../data/catalog";
import videos from "../../data/videos.json";
import { getPublished, SHOW_UNRELEASED } from "../../lib/release";

type Video = { title: string; line: string; alt: string; since: string; released: boolean; width: number; height: number; seconds: number; group?: string; feature?: string };
type Clip = Video & { id: string; group: string };

// Every video with the group page it belongs on (a group's own video has the group's id).
const clips = (): Clip[] => Object.entries(videos as Record<string, Video>).map(([id, v]) => ({ ...v, id, group: v.group ?? id }));

export async function getStaticPaths() {
  // Astro runs this on its own, without the rest of the frontmatter, so it lists the videos itself.
  const all = Object.entries(videos as Record<string, Video>).map(([id, v]) => ({ ...v, id, group: v.group ?? id }));
  const published = await getPublished();
  const live = (f: Feature) => f.since !== "coming" && shown(f, published, SHOW_UNRELEASED);
  const shows = (v: Clip) => (v.released && published.has(v.since)) || SHOW_UNRELEASED;
  const filmed = (id: string) => all.some((v) => v.group === id && shows(v));
  return groups.filter((g) => g.features.some(live) && filmed(g.id)).map((g) => ({ params: { id: g.id } }));
}

const { id } = Astro.params;
const published = await getPublished();
const isPublished = (f: Feature) => f.since === "coming" || published.has(f.since);
const live = (f: Feature) => f.since !== "coming" && shown(f, published, SHOW_UNRELEASED);
const shows = (v: Clip) => (v.released && published.has(v.since)) || SHOW_UNRELEASED;
const out = (v: Clip) => v.released && published.has(v.since);
const filmed = (id: string) => clips().some((v) => v.group === id && shows(v));
const pages = groups.filter((g) => g.features.some(live) && filmed(g.id));
const at = pages.findIndex((g) => g.id === id);
const g = pages[at];
const features = g.features.filter((f) => shown(f, published, SHOW_UNRELEASED));
const drafts = features.filter((f) => !isPublished(f));

const video = clips().find((v) => v.group === g.id && !v.feature && shows(v));
// The features' own videos, in the order the features are listed.
const order = (v: Clip) => g.features.findIndex((f) => f.title === v.feature);
const featureVideos = clips().filter((v) => v.group === g.id && v.feature && shows(v)).sort((a, b) => order(a) - order(b));

const files = import.meta.glob<{ default: ImageMetadata }>("../../assets/screens/*.webp", { eager: true });
const image = (name: string) => files[`../../assets/screens/${name}.webp`]?.default;
const isCrop = (name: string) => /-(card|panel|menu|window)$/.test(name);
// Six at most: the page is the video and what it does; /features has every shot.
const stills = features.filter((f) => f.shot && f.since !== "coming" && image(f.shot)).slice(0, 6);

const badge = (f: Feature) =>
  f.since === "coming" ? { cls: "coming", text: "Coming" } : f.since === "0.1.0" ? null : isPublished(f) ? { cls: "new", text: `New in ${f.since}` } : { cls: "draft", text: f.since === "next" ? "Next release" : `New in ${f.since}` };

const prev = pages[(at - 1 + pages.length) % pages.length];
const next = pages[(at + 1) % pages.length];
const lead = video?.title ?? `${g.name}.`;
---

<Layout title={`${g.name} · Airc`} description={`${g.name} in Airc: ${g.sub} ${features.filter((f) => f.since !== "coming").map((f) => f.title).join(", ")}.`}>
  <article class="fp" style={`--c:${g.color}`}>
    <a class="back" href={`/features#${g.id}`}><span aria-hidden="true">←</span> Every feature</a>
    <p class="tag">{g.name}</p>
    <h1>{lead} <span>{g.sub}</span></h1>
    {drafts.length > 0 && (
      <p class="draft-note"><i aria-hidden="true"></i>Preview: part of this is in the next release, which isn't published yet.</p>
    )}

    {video ? (
      <figure class="stage">
        <video class="win" autoplay muted loop playsinline preload="auto" poster={`/video/${video.id}.jpg`} width={video.width} height={video.height} aria-label={video.alt} data-video>
          <source src={`/video/${video.id}.mp4`} type="video/mp4" />
        </video>
        <figcaption>{video.line} <span>Rendered by Airc itself, frame by frame. Not a screen recording.</span></figcaption>
      </figure>
    ) : stills[0] && (
      <figure class={`stage ${isCrop(stills[0].shot!) ? "stage-crop" : ""}`}>
        <Image class="win-still" src={image(stills[0].shot!)!} widths={[800, 1280, 1920]} sizes="(max-width: 900px) 94vw, 1000px" alt={shotAlt[stills[0].shot!] ?? stills[0].title} loading="eager" />
      </figure>
    )}

    <section class="facts" aria-label={`What ${g.name} does`}>
      {features.map((f) => {
        const b = badge(f);
        return (
          <div class="fact">
            <h2>{f.title}{b && <span class={`badge badge-${b.cls}`}>{b.text}</span>}</h2>
            <p>{f.line}</p>
          </div>
        );
      })}
    </section>

    {featureVideos.map((v) => (
      <figure class="stage stage-feature">
        <h2>
          {v.title}
          {!out(v) && <span class="badge badge-draft">{v.since === "next" ? "Next release" : `New in ${v.since}`}</span>}
        </h2>
        <video class="win" muted loop playsinline preload="metadata" poster={`/video/${v.id}.jpg`} width={v.width} height={v.height} aria-label={v.alt} data-video>
          <source src={`/video/${v.id}.mp4`} type="video/mp4" />
        </video>
        <figcaption>{v.line}</figcaption>
      </figure>
    ))}

    {stills.length > (video ? 0 : 1) && (
      <section class="stills" aria-label="Screenshots">
        {(video ? stills : stills.slice(1)).map((f) => (
          <figure class={`still ${isCrop(f.shot!) ? "still-crop" : ""}`}>
            <Image src={image(f.shot!)!} widths={[640, 1280]} sizes="(max-width: 900px) 94vw, 520px" alt={shotAlt[f.shot!] ?? f.title} />
            <figcaption>{f.title}</figcaption>
          </figure>
        ))}
      </section>
    )}

    <nav class="pager" aria-label="Other features">
      {pages.length > 1 ? <a href={`/features/${prev.id}`} style={`--c:${prev.color}`}><span>Previous</span>{prev.name}</a> : <span />}
      <a href="/features" class="all">Every feature</a>
      {pages.length > 1 ? <a href={`/features/${next.id}`} style={`--c:${next.color}`} class="next"><span>Next</span>{next.name}</a> : <span />}
    </nav>

    <footer class="end">
      <Download from={`feature-${g.id}`} />
    </footer>
  </article>
</Layout>

<script>
  // The video loops while it's on screen; with reduced motion it waits, with controls, for a press of play.
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  for (const v of document.querySelectorAll<HTMLVideoElement>("video[data-video]")) {
    if (reduce) {
      v.removeAttribute("autoplay");
      v.pause();
      v.controls = true;
      continue;
    }
    new IntersectionObserver(([e]) => (e.isIntersecting ? v.play().catch(() => {}) : v.pause())).observe(v);
  }
</script>

<style>
  .fp {
    --cont: #7a8190;
    max-width: 1120px;
    margin: 0 auto;
    padding: clamp(36px, 5vw, 64px) clamp(20px, 4vw, 56px) 0;
  }

  .back {
    display: flex;
    width: fit-content;
    gap: 6px;
    margin-bottom: 28px;
    font-size: 13.5px;
    font-weight: 550;
    color: var(--t2);
  }

  .back:hover { color: var(--t1); }

  .tag {
    display: inline-flex;
    align-items: center;
    height: 24px;
    margin-bottom: 18px;
    padding: 0 9px;
    border-radius: 7px;
    font-size: 12.5px;
    font-weight: 600;
    color: color-mix(in srgb, var(--c) 78%, #000);
    background: color-mix(in srgb, var(--c) 11%, var(--bg));
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--c) 22%, transparent);
  }

  h1 {
    max-width: 820px;
    font-size: clamp(32px, 4vw, 50px);
    line-height: 1.08;
    font-weight: 550;
    letter-spacing: -0.026em;
    color: var(--t1);
    text-wrap: balance;
  }

  h1 span { color: var(--cont); }

  .draft-note {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 18px;
    padding: 6px 10px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 500;
    color: #8a5a00;
    background: rgb(232 163 43 / 0.14);
  }

  .draft-note i { width: 6px; height: 6px; border-radius: 50%; background: #e8a32b; }

  /* The video in the window's own frame (16 px corners, as Airc's window), on the dotted cell. */
  .stage {
    display: grid;
    justify-items: center;
    gap: 16px;
    margin: clamp(32px, 4vw, 48px) 0 0;
    padding: clamp(20px, 4vw, 48px);
    border-radius: 18px;
    background:
      radial-gradient(60% 80% at 20% 0%, color-mix(in srgb, var(--c) 14%, transparent), transparent 70%),
      radial-gradient(circle at 1px 1px, rgb(var(--ink) / 0.075) 1px, transparent 1.4px) 0 0 / 16px 16px,
      var(--bg-sunk);
    box-shadow: inset 0 0 0 1px var(--hl);
  }

  .win,
  .stage :global(.win-still) {
    display: block;
    width: 100%;
    max-width: 1000px;
    height: auto;
    aspect-ratio: 1440 / 900;
    border-radius: 16px;
    background: var(--bg-sunk);
    box-shadow: 0 0 0 0.5px rgb(0 0 0 / 0.22), 0 1px 2px rgb(0 0 0 / 0.06), 0 30px 60px -24px rgb(30 25 20 / 0.42);
  }

  .stage :global(.win-still) { aspect-ratio: auto; }
  .stage-crop :global(.win-still) { width: auto; max-width: min(100%, 720px); border-radius: 0; box-shadow: none; filter: drop-shadow(0 0 0.5px rgb(0 0 0 / 0.3)) drop-shadow(0 20px 30px rgb(30 25 20 / 0.2)); }

  .stage-feature { margin-top: clamp(40px, 5vw, 64px); }
  .stage-feature h2 { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; justify-self: start; font-size: 22px; font-weight: 600; letter-spacing: -0.02em; color: var(--t1); }

  .stage figcaption { font-size: 15px; font-weight: 500; color: var(--t1); text-align: center; text-wrap: balance; }
  .stage figcaption span { display: block; margin-top: 4px; font-size: 12.5px; font-weight: 450; color: var(--t3); }

  /* What it does: a hairline grid of cells. */
  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: clamp(40px, 5vw, 64px);
    box-shadow: 0 -1px 0 var(--hl);
  }

  .fact { padding: 22px 24px 24px 0; box-shadow: 0 1px 0 var(--hl); }
  .fact:nth-child(even) { padding: 22px 0 24px 24px; box-shadow: 0 1px 0 var(--hl), -1px 0 0 var(--hl); }

  .fact h2 {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    font-size: 16.5px;
    font-weight: 600;
    letter-spacing: -0.016em;
    color: var(--t1);
  }

  .fact p { margin-top: 6px; max-width: 460px; font-size: 15px; line-height: 1.55; color: var(--t2); }

  .badge { display: inline-flex; align-items: center; height: 20px; padding: 0 7px; border-radius: 6px; font-size: 11.5px; font-weight: 600; }
  .badge-new { color: #1f7a4a; background: rgb(47 158 98 / 0.12); }
  .badge-draft { color: #8a5a00; background: rgb(232 163 43 / 0.16); }
  .badge-coming { color: #5b3fc0; background: rgb(122 76 240 / 0.12); }

  /* The stills, two to a row. */
  .stills {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin-top: clamp(40px, 5vw, 64px);
  }

  .still { display: grid; gap: 10px; margin: 0; }

  .still :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 12px;
    box-shadow: 0 0 0 0.5px rgb(0 0 0 / 0.12);
  }

  .still-crop {
    align-content: start;
  }

  .still-crop :global(img) {
    width: auto;
    max-width: 100%;
    max-height: 380px;
    justify-self: center;
    padding: 24px;
    border-radius: 14px;
    box-shadow: none;
    background:
      radial-gradient(circle at 1px 1px, rgb(var(--ink) / 0.075) 1px, transparent 1.4px) 0 0 / 16px 16px,
      var(--bg-sunk);
    object-fit: contain;
  }

  .still figcaption { font-size: 13.5px; font-weight: 500; color: var(--t2); }

  .pager {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    margin-top: clamp(48px, 6vw, 80px);
    padding-top: 24px;
    box-shadow: 0 -1px 0 var(--hl);
  }

  .pager a { display: grid; gap: 2px; font-size: 16px; font-weight: 600; color: var(--t1); }
  .pager a span { font-size: 12.5px; font-weight: 500; color: var(--t3); }
  .pager a:hover { color: color-mix(in srgb, var(--c, var(--t1)) 80%, #000); }
  .pager .all { font-size: 14px; font-weight: 550; color: var(--t2); }
  .pager .next { justify-self: end; text-align: right; }

  .end { display: grid; justify-items: center; margin-top: clamp(48px, 6vw, 80px); padding: clamp(40px, 5vw, 64px) 0; box-shadow: 0 -1px 0 var(--hl); }

  @media (max-width: 760px) {
    .facts, .stills { grid-template-columns: 1fr; }
    .fact, .fact:nth-child(even) { padding: 18px 0 20px; box-shadow: 0 1px 0 var(--hl); }
    .stage { margin-inline: -8px; padding: 14px; border-radius: 14px; }
    .win, .stage :global(.win-still) { border-radius: 10px; }
    .pager { grid-template-columns: 1fr 1fr; }
    .pager .all { display: none; }
    .pager:has(> span) .all { display: block; grid-column: 1 / -1; justify-self: center; }
    .back { min-height: 44px; align-items: center; margin-bottom: 12px; }
  }
</style>
