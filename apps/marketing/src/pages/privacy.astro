---
// The privacy page. The app's part is docs/user/telemetry.md itself, up to its "For contributors" section (copied to
// src/content by scripts/sync-privacy.mjs before each build), so this page says what the app does. The website's part
// is written here.
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import { CONTACT_EMAIL } from "../lib/site";
import privacyShot from "../assets/screens/settings-privacy.webp";
import eventsShot from "../assets/screens/settings-privacy-events.webp";
import * as telemetry from "../content/telemetry.md";

const html = await telemetry.compiledContent();
const cut = html.search(/<h2[^>]*>\s*For contributors/i);
const appPart = (cut > 0 ? html.slice(0, cut) : html).replace(/<h1[^>]*>.*?<\/h1>/s, "");
---

<Layout title="Privacy · Airc" description="What the Airc app sends, what it never sends, how to turn it off, and what this website does.">
  <article class="privacy">
    <p class="tag">Privacy</p>
    <h1>Privacy. <span>What Airc sends, what it never sends, and how to turn it off.</span></h1>

    <div class="shots">
      <figure>
        <Image src={privacyShot} widths={[600, 900, 1200, 1800]} sizes="(max-width: 760px) 100vw, 360px" quality={90} alt="Airc's Settings → Privacy: Share anonymous usage data, See what Airc sends, the anonymous ID, crash reports and search suggestions." />
        <figcaption>Settings → Privacy: one switch turns it all off.</figcaption>
      </figure>
      <figure>
        <Image src={eventsShot} widths={[600, 900, 1200, 1800]} sizes="(max-width: 760px) 100vw, 360px" quality={90} alt="Airc's See what Airc sends sheet: the last events, word for word, as they go to PostHog." />
        <figcaption>See what Airc sends: every event, word for word.</figcaption>
      </figure>
    </div>

    <section class="block">
      <h2>The app</h2>
      <div class="md" set:html={appPart} />
    </section>

    <section class="block">
      <h2>This website</h2>
      <p>
        aircbrowser.com counts visits with PostHog's EU cloud, the same project as the app: which pages and sections
        are viewed, the referring site, and which buttons and demos are used (the download button, the Spaces demo,
        the colour picker, the command bar).
      </p>
      <p>
        It sets no cookies and stores nothing in your browser: each visit gets a random ID that is gone when you close
        the tab. Your IP address isn't kept and no location is looked up from it. There are no person profiles, no
        session recordings and no ads. If your browser sends Do Not Track, nothing is counted. The requests go to
        aircbrowser.com/ingest, which passes them to PostHog.
      </p>
      <p>
        When you download Airc we count the download, with the country and the referring site's name (no IP address,
        no full web address, no cookie, nothing that identifies you), as one anonymous event in the same project.
      </p>
      <p>
        The site is hosted on Vercel, which keeps standard request logs. Downloads and update feeds come from Vercel
        Blob. The countdown runs in your browser and sends nothing.
      </p>
      <p>
        Questions about your data: <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
      </p>
    </section>
  </article>
</Layout>

<style>
  .privacy {
    --cont: #7a8190;
    max-width: 760px;
    margin: 0 auto;
    padding: clamp(48px, 7vw, 96px) clamp(20px, 4vw, 56px);
  }

  @media (prefers-color-scheme: dark) {
    .privacy { --cont: #a0a6b2; }
  }

  .tag {
    display: inline-flex;
    align-items: center;
    height: 24px;
    margin-bottom: 18px;
    padding: 0 9px;
    border-radius: 7px;
    font-size: 12.5px;
    font-weight: 550;
    color: var(--t2);
    background: var(--panel);
    box-shadow: inset 0 0 0 1px var(--hl);
  }

  h1 {
    font-size: clamp(30px, 3.4vw, 44px);
    line-height: 1.1;
    font-weight: 550;
    letter-spacing: -0.022em;
    color: var(--t1);
    text-wrap: balance;
  }

  h1 span { color: var(--cont); }

  .shots { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 36px; }
  .shots figure { margin: 0; }
  .shots :global(img) { display: block; width: 100%; height: auto; border-radius: 12px; box-shadow: 0 0 0 0.5px rgb(var(--ink) / 0.1), 0 14px 30px -20px rgb(30 25 50 / 0.35); }
  .shots figcaption { margin-top: 8px; font-size: 13px; font-weight: 500; color: var(--t3); }

  @media (max-width: 640px) {
    .shots { grid-template-columns: 1fr; }
  }

  .block { margin-top: 48px; padding-top: 32px; box-shadow: 0 -1px 0 var(--hl); }

  .block > h2 {
    margin-bottom: 8px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--t3);
  }

  .block > p,
  .md :global(p),
  .md :global(li) {
    font-size: 16px;
    line-height: 1.6;
    font-weight: 450;
    color: var(--t2);
  }

  .block > p + p,
  .md :global(p + p) { margin-top: 12px; }

  .md :global(h2) {
    margin: 40px 0 12px;
    font-size: 22px;
    line-height: 1.25;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--t1);
  }

  .md :global(strong) { font-weight: 600; color: var(--t1); }
  .md :global(ul) { margin: 12px 0; padding-left: 20px; }
  .md :global(li + li) { margin-top: 6px; }

  .md :global(code) {
    font-family: var(--mono);
    font-size: 0.86em;
    padding: 1px 5px;
    border-radius: 5px;
    background: var(--panel);
    box-shadow: inset 0 0 0 1px var(--hl);
  }

  .md :global(pre) {
    margin: 12px 0;
    padding: 14px 16px;
    overflow-x: auto;
    border-radius: 10px;
    background: var(--panel) !important;
    box-shadow: inset 0 0 0 1px var(--hl);
  }

  .md :global(pre code) { padding: 0; background: none; box-shadow: none; }

  .md :global(table) {
    width: 100%;
    margin: 16px 0;
    border-collapse: collapse;
    font-size: 14px;
  }

  .md :global(th),
  .md :global(td) {
    padding: 10px 12px 10px 0;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--hl);
    color: var(--t2);
  }

  .md :global(th) { font-weight: 600; color: var(--t1); }
  .md :global(td code) { white-space: nowrap; }

  a,
  .md :global(a) { color: var(--t1); text-decoration: underline; text-decoration-color: var(--hl-strong); text-underline-offset: 3px; }

  @media (max-width: 640px) {
    .md :global(table) { display: block; overflow-x: auto; }
  }
</style>
